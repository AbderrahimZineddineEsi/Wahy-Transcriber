Dialogue: 0,0:00:00.90,0:00:01.26,Default,,0,0,0,,لا.
Dialogue: 0,0:00:30.00,0:00:31.64,Ayah,,0,0,0,,﴿ورحمت الله وبركاته﴾ [هود: 73]
Dialogue: 0,0:00:31.64,0:00:33.32,Default,,0,0,0,,وبركاته وبركاته وقال الله تعالى، إن أردسل الله وقته ومركاته، قال الله
Dialogue: 0,0:00:33.32,0:00:39.00,Default,,0,0,0,,تعالى بشكل كله، قال الله تعالى، فقال رسول
Dialogue: 0,0:00:39.00,0:00:41.02,Default,,0,0,0,,الله صلى الله عليه وسلم،
Dialogue: 0,0:00:41.02,0:00:48.85,Hadith,,0,0,0,,«ولا الجهاد في سبيل الله تعالى، إلا رجل خرج بنفسه وماله فلم يرجع من ذلك بشيء،» [سنن أبي داود (2438)]
Dialogue: 0,0:00:48.85,0:00:49.96,Default,,0,0,0,,أخرجه البخاري
Dialogue: 0,0:00:52.70,0:00:56.70,Default,,0,0,0,,بسم الله الرحمن الرحيم الحمد لله رب العالمين
Dialogue: 0,0:00:56.70,0:01:04.09,Hadith,,0,0,0,,«وأشهد أن لا إله إلا الله وحده لا شريك له وأشهد أن محمدًا عبده ورسوله» [صحيح مسلم (554)]
Dialogue: 0,0:01:04.09,0:01:09.18,Default,,0,0,0,,صلى الله وسلم عليه وعلى آله وأصحابه أجمعين
Dialogue: 0,0:01:10.31,0:01:15.43,Default,,0,0,0,,اللهم علمنا ما ينفعنا وانفعنا بما علمتنا وزدنا علماً
Dialogue: 0,0:01:15.43,0:01:17.29,Hadith,,0,0,0,,«وأصلح لنا شأننا كله» [سنن ابن ماجه (3836)]
Dialogue: 0,0:01:17.29,0:01:21.15,Hadith,,0,0,0,,«ولا تكلنا إلى أهوسنا طرفة عين» [سنن أبي داود (5090)]
Dialogue: 0,0:01:22.07,0:01:23.71,Hadith,,0,0,0,,«اللهم فقهنا في الدين» [صحيح البخاري (143)]
Dialogue: 0,0:01:23.71,0:01:28.71,Default,,0,0,0,,ووفقنا لاتباع هدي نبيك الكريم صلى الله عليه وسلم
Dialogue: 0,0:01:30.37,0:01:35.50,Default,,0,0,0,,أما بعد، لا نزال في الباب الثاني من هذا الكتاب
Dialogue: 0,0:01:35.50,0:01:40.64,Default,,0,0,0,,كفاية المتعبد للحافظ المنذري رحمه الله تعالى
Dialogue: 0,0:01:40.64,0:01:46.01,Default,,0,0,0,,وهو يتعلق بفضائل
Dialogue: 0,0:01:46.01,0:01:46.70,Default,,0,0,0,,الصيام
Dialogue: 0,0:01:48.43,0:01:53.98,Default,,0,0,0,,وذكر رحمه الله تعالى جملة من الفضائل
Dialogue: 0,0:01:53.98,0:01:58.98,Default,,0,0,0,,فيما تعلق بالصيام عموماً وفيما
Dialogue: 0,0:01:58.98,0:02:04.37,Default,,0,0,0,,تعلق بصيام أيام من السنة أو
Dialogue: 0,0:02:04.37,0:02:05.92,Default,,0,0,0,,من الشهر أو الأسبوع
Dialogue: 0,0:02:09.47,0:02:14.47,Default,,0,0,0,,وذكر هنا رحمه الله تعالى ما جاء في العمل في
Dialogue: 0,0:02:14.47,0:02:17.52,Hadith,,0,0,0,,«عشر ذي الحجة،» [جامع الترمذي (758)]
Dialogue: 0,0:02:17.52,0:02:22.81,Default,,0,0,0,,وأورد حديثاً عاماً في فضل عموم العمل
Dialogue: 0,0:02:22.81,0:02:28.24,Default,,0,0,0,,في العشر الأوائل
Dialogue: 0,0:02:28.24,0:02:28.75,Default,,0,0,0,,من شهر
Dialogue: 0,0:02:28.75,0:02:33.91,Hadith,,0,0,0,,«ذي الحجة وإراده» [صحيح مسلم (5121)]
Dialogue: 0,0:02:33.91,0:02:39.18,Default,,0,0,0,,ذلك رحمه الله تعالى في باب فضائل الصيام من أجل
Dialogue: 0,0:02:39.18,0:02:45.13,Default,,0,0,0,,أن من جملة العمل الذي يفعل في
Dialogue: 0,0:02:45.13,0:02:50.36,Default,,0,0,0,,الأوائل منذ الحجة
Dialogue: 0,0:02:50.36,0:02:57.12,Default,,0,0,0,,عدا يوم النحر الصيام
Dialogue: 0,0:02:58.71,0:03:04.09,Default,,0,0,0,,فهو من جملة الأعمال الصالحة، لأن النبي صلى الله عليه وسلم عمّم
Dialogue: 0,0:03:04.09,0:03:04.37,Default,,0,0,0,,قال
Dialogue: 0,0:03:04.37,0:03:08.03,Hadith,,0,0,0,,«ما من أيامنا العمل الصالح فيهن،» [سنن أبي داود (2438)]
Dialogue: 0,0:03:08.03,0:03:13.21,Default,,0,0,0,,فيسمى القوله العمل الصالح الصيّن، فهو
Dialogue: 0,0:03:13.21,0:03:17.47,Default,,0,0,0,,من جملة الأعمال الصالحة التي يحرص على القيام بها
Dialogue: 0,0:03:17.47,0:03:21.52,Hadith,,0,0,0,,«في العشر الأول من شهر ذي الحجة،» [سنن النسائي (4362)]
Dialogue: 0,0:03:23.68,0:03:28.69,Default,,0,0,0,,والعشر الأول من شهر ذي الحجة أيامها
Dialogue: 0,0:03:28.69,0:03:33.53,Default,,0,0,0,,خير الأيام كما أن الليالي
Dialogue: 0,0:03:33.53,0:03:36.74,Hadith,,0,0,0,,«العشر الأخيرة من رمضان هي» [بلوغ المرام (806)]
Dialogue: 0,0:03:36.74,0:03:39.91,Default,,0,0,0,,خير الليالي فخير أيام السنة
Dialogue: 0,0:03:39.91,0:03:42.65,Hadith,,0,0,0,,«العشر الأول من ذي الحجة» [سنن النسائي (4362)]
Dialogue: 0,0:03:42.65,0:03:43.24,Default,,0,0,0,,وخير
Dialogue: 0,0:03:43.24,0:03:51.81,Hadith,,0,0,0,,«ليالي السنة العشر الأواخر من رمضان وفي العشر الأواقر من رمضان» [صحيح البخاري (2017)]
Dialogue: 0,0:03:51.81,0:03:56.50,Ayah,,0,0,0,,﴿ليلة القدر ويخير من ألف شهر،﴾ [القدر: 3]
Dialogue: 0,0:03:56.50,0:04:01.63,Default,,0,0,0,,وفي العشر الأوائل من ذي الحجة يوم عرفة ووسيد الأيام
Dialogue: 0,0:04:01.63,0:04:05.75,Default,,0,0,0,,وخيرها وأفضلها، فالحاصل أن
Dialogue: 0,0:04:05.75,0:04:09.46,Hadith,,0,0,0,,«العشر الأول من ذي الحجة» [سنن النسائي (4362)]
Dialogue: 0,0:04:09.46,0:04:14.56,Default,,0,0,0,,أيام فاضلة وعظيمة ومباركة، وهي
Dialogue: 0,0:04:14.56,0:04:14.86,Default,,0,0,0,,خير
Dialogue: 0,0:04:14.86,0:04:16.93,Hadith,,0,0,0,,«أيام العمل الصالح،» [سنن أبي داود (2438)]
Dialogue: 0,0:04:17.51,0:04:23.62,Default,,0,0,0,,وينبغي على العبد المسلم إذا أوفق لإدراكها أن
Dialogue: 0,0:04:23.62,0:04:29.27,Default,,0,0,0,,يغنم العمل الصالح فيها من صلاة وصيام وصدقة
Dialogue: 0,0:04:29.27,0:04:36.13,Default,,0,0,0,,وغير ذلك من الطاعات والعبادات، وأورد
Dialogue: 0,0:04:36.13,0:04:41.39,Default,,0,0,0,,رحمه الله تعالى حديث ابن عباس رضي الله عنهما أن
Dialogue: 0,0:04:41.39,0:04:43.56,Default,,0,0,0,,نبي صلى الله عليه وسلم قال
Dialogue: 0,0:04:43.56,0:04:52.66,Hadith,,0,0,0,,«ما من أيام العمل الصالح فيهن أحب إلى الله تعالى من هذه الأيام العشر، …»
Dialogue: 0,0:04:52.66,0:05:00.81,Hadith,,0,0,0,,«… أي العشر الأول من شرر الحجة، فقالوا يا رسول الله ولا الجهاد في سبيل الله، …»
Dialogue: 0,0:05:00.81,0:05:06.63,Hadith,,0,0,0,,«… فقال رسول الله صلى الله عليه وسلم ولا الجهاد في سبيل الله، …»
Dialogue: 0,0:05:06.63,0:05:12.19,Hadith,,0,0,0,,«… إلا رجل خرج بنفسه وماله فلم يرجع من ذلك بشيء،» [جامع الترمذي (757)]
Dialogue: 0,0:05:12.19,0:05:14.50,Default,,0,0,0,,قال أخرجه البخاري
Dialogue: 0,0:05:15.48,0:05:15.77,Default,,0,0,0,,وهذا
Dialogue: 0,0:05:15.77,0:05:17.50,Hadith,,0,0,0,,«اللفظ الذي ساقه» [بلوغ المرام (730)]
Dialogue: 0,0:05:17.50,0:05:22.62,Default,,0,0,0,,رحمه الله تعالى هو لفظ الترمذي في جامعه، أما
Dialogue: 0,0:05:22.62,0:05:27.77,Default,,0,0,0,,لفظ الإمام البخاري قال ما العمل، قال النبي صلى
Dialogue: 0,0:05:27.77,0:05:28.69,Default,,0,0,0,,الله عليه وسلم
Dialogue: 0,0:05:28.69,0:05:36.62,Hadith,,0,0,0,,«ما العمل في أيام أفضل من العمل في هذه العشر الأول منذ الحجة، …»
Dialogue: 0,0:05:36.62,0:05:46.98,Hadith,,0,0,0,,«… قال ولا الجهاد إلا رجل خرج يخاطر بنفسه، وما له فلم يرجع بشيء،» [صحيح البخاري (969)]
Dialogue: 0,0:05:46.98,0:05:52.25,Default,,0,0,0,,والحديث دلّا
Dialogue: 0,0:05:52.25,0:05:58.24,Default,,0,0,0,,دلالة ظاهرة على فضل هذه العشر وعظم
Dialogue: 0,0:05:58.24,0:06:00.42,Default,,0,0,0,,ميشانها، وأن خير
Dialogue: 0,0:06:00.42,0:06:10.00,Hadith,,0,0,0,,«أيام العمل الصالح، وأن المسلم ينبغي أن يغنم تلك الأيام،» [سنن أبي داود (2438)]
Dialogue: 0,0:06:10.00,0:06:12.04,Default,,0,0,0,,وأن يحرص فيها على
Dialogue: 0,0:06:12.04,0:06:16.89,Hadith,,0,0,0,,«الأعمال الصالحة، ومن جملة العمل الصالح الذي» [سنن ابن ماجه (1225)]
Dialogue: 0,0:06:16.89,0:06:22.51,Default,,0,0,0,,يحرص عليه في هذه العشر الصيام، ولأجل
Dialogue: 0,0:06:22.51,0:06:28.01,Default,,0,0,0,,هذا أورده المنذر رحمه الله تعالى في الأبواب المتعلقة
Dialogue: 0,0:06:28.01,0:06:30.30,Default,,0,0,0,,بفضائل الصيام نام
Dialogue: 0,0:06:32.01,0:06:35.60,Default,,0,0,0,,قال رحمه الله تعالى ما جاء في صيام يوم عرفة
Dialogue: 0,0:06:35.60,0:06:38.87,Hadith,,0,0,0,,«وثلاثة أيام من كل شهر ويوم الاثنين» [سنن النسائي (2414)]
Dialogue: 0,0:06:39.86,0:06:41.56,Default,,0,0,0,,روى أبو قتادة رضي الله عنه أن رسول الله صلى الثمن والبغوات
Dialogue: 0,0:06:41.56,0:06:51.12,Default,,0,0,0,,أن يوم أنفسه. قال عمرا،
Dialogue: 0,0:06:51.12,0:06:53.43,Default,,0,0,0,,علي الضقيف وتباني محمد بالظميل على سيدنا حدا فرعا ومستخدم جميع متعا
Dialogue: 0,0:06:53.43,0:06:57.58,Default,,0,0,0,,من حيثتنا. نعم.
Dialogue: 0,0:07:24.55,0:07:28.25,Default,,0,0,0,,فأعد من قوله هو قال فسئل عن
Dialogue: 0,0:07:28.25,0:07:34.55,Hadith,,0,0,0,,«صيام يومين وإفطار يوم» [صحيح البخاري (5052)]
Dialogue: 0,0:07:34.55,0:07:36.61,Default,,0,0,0,,قال ومن يطيق ذلك؟
Dialogue: 0,0:07:36.61,0:07:42.56,Hadith,,0,0,0,,«قال وسئل عن صوم يوم وإفطار يوم قال ذاك صوم أخي داود داود قبله، …»
Dialogue: 0,0:07:42.56,0:07:58.64,Hadith,,0,0,0,,«… يبدو عندك سقط عندك، في سقط عندك، حتى النسقطة، نعم، قال وسئل عن صوم يوم وإشطار يومين، …»
Dialogue: 0,0:07:58.64,0:08:06.47,Hadith,,0,0,0,,«… قال ليت أن الله عز وجل قوان لذلك، قال وسئل عن صوم يوم وإشطار يوم، …»
Dialogue: 0,0:08:06.47,0:08:16.93,Hadith,,0,0,0,,«… قال ذلك صوم أخي داود، نعم، قال وسئل عن صيام يوم الاثنين، فقال ذاك يوم ولدت فيه، …»
Dialogue: 0,0:08:16.93,0:08:22.43,Hadith,,0,0,0,,«… ويوم بعثت وأنزل علي فيه، قال فقال فصوم ثلاثة» [صحيح مسلم (2747)]
Dialogue: 0,0:08:22.43,0:08:27.93,Default,,0,0,0,,أيام من كل شهر، ورمضان إلى رمضان صوم الدهر، قال فالسئل
Dialogue: 0,0:08:27.93,0:08:32.37,Default,,0,0,0,,عن صوم عاشراء، فقال يكفر السنة، انفرد به مسلم
Dialogue: 0,0:08:33.51,0:08:38.78,Default,,0,0,0,,ثم عقد رحمه الله تعالى هذه الترجمة في
Dialogue: 0,0:08:38.78,0:08:40.66,Default,,0,0,0,,جملة من الفضائل
Dialogue: 0,0:08:40.66,0:08:43.67,Ayah,,0,0,0,,﴿جمعها حديث واحد﴾ [الفرقان: 32]
Dialogue: 0,0:08:43.67,0:08:48.87,Default,,0,0,0,,وحديث أبي قتادة رضي الله عنه في فضل
Dialogue: 0,0:08:48.87,0:08:50.47,Hadith,,0,0,0,,«صيام يوم عرفة» [صحيح مسلم (2746)]
Dialogue: 0,0:08:50.47,0:08:51.25,Default,,0,0,0,,وفضل
Dialogue: 0,0:08:51.25,0:08:52.89,Ayah,,0,0,0,,﴿صيام ثلاثة أيام﴾ [البقرة: 196]
Dialogue: 0,0:08:52.89,0:08:58.00,Default,,0,0,0,,من كل شهر وفضل صيام الاثنين إلى أيضا
Dialogue: 0,0:08:58.00,0:09:01.99,Default,,0,0,0,,جملة من الفضائل الأخرى المتعلقة بالصيام
Dialogue: 0,0:09:02.50,0:09:08.37,Default,,0,0,0,,وقال رسول
Dialogue: 0,0:09:08.37,0:09:13.89,Default,,0,0,0,,الله صلى الله عليه وسلم سئل عن صومه، أي سأله رجل
Dialogue: 0,0:09:13.89,0:09:19.13,Default,,0,0,0,,عن صومه، أي عن صوم النبي عليه الصلاة والسلام،
Dialogue: 0,0:09:19.13,0:09:25.63,Default,,0,0,0,,فغضب عليه الصلاة والسلام، وغضبه
Dialogue: 0,0:09:25.63,0:09:31.17,Default,,0,0,0,,عليه الصلاة والسلام عن كراهية لهذه المسألة، غضب
Dialogue: 0,0:09:31.17,0:09:36.37,Default,,0,0,0,,لأنه كره، من هذا السائل هذه المسألة،
Dialogue: 0,0:09:36.37,0:09:44.39,Default,,0,0,0,,سؤاله عن صيام النبي عليه الصلاة والسلام، لأن الصيام
Dialogue: 0,0:09:44.39,0:09:50.62,Default,,0,0,0,,باب منافسة، والناس يتفاوتون فيه، تفاوة
Dialogue: 0,0:09:50.62,0:09:55.99,Default,,0,0,0,,عظيماً، وكان الجدير في
Dialogue: 0,0:09:55.99,0:09:58.97,Default,,0,0,0,,مثل هذا المقام أن يكون السؤال كم أصوم؟
Dialogue: 0,0:09:59.51,0:10:04.75,Default,,0,0,0,,يسأل عنه، فيجيبه النبي عليه الصلاة والسلام بما يناسب
Dialogue: 0,0:10:04.75,0:10:09.50,Default,,0,0,0,,حاله، لأن
Dialogue: 0,0:10:09.50,0:10:10.50,Hadith,,0,0,0,,«باب الصيام باب» [صحيح البخاري (3666)]
Dialogue: 0,0:10:10.50,0:10:15.71,Default,,0,0,0,,واسع، والنبي صلى الله عليه وسلم يطيق من الصيام
Dialogue: 0,0:10:15.71,0:10:16.99,Default,,0,0,0,,ما لا تطيق أمته
Dialogue: 0,0:10:16.99,0:10:20.28,Hadith,,0,0,0,,«صلوات الله وسلامه عليه،» [رياض الصالحين (1275)]
Dialogue: 0,0:10:20.28,0:10:25.47,Default,,0,0,0,,وفي الحديث قال إني أبيت عند ربي يطعمني ويسقين،
Dialogue: 0,0:10:26.95,0:10:33.47,Default,,0,0,0,,فغضب عليه الصلاة والسلام كرهية لهذه المسألة، الذي
Dialogue: 0,0:10:33.47,0:10:40.80,Default,,0,0,0,,يناسب في هذا المقام أن يقول كم أصوم، فكره
Dialogue: 0,0:10:40.80,0:10:46.37,Default,,0,0,0,,النبي صلى الله عليه وسلم مسألة فغضب صلاة الله وسلم عليه،
Dialogue: 0,0:10:46.37,0:10:46.92,Default,,0,0,0,,فقال
Dialogue: 0,0:10:46.92,0:10:54.71,Hadith,,0,0,0,,«عمر رضي الله عنه رضينا بالله ربا وبالإسلام دينا ومحمد صلى الله عليه وسلم رسولا» [صحيح البخاري (6362)]
Dialogue: 0,0:10:54.71,0:11:00.19,Default,,0,0,0,,وببيعته، وقال رأى النبي عليه
Dialogue: 0,0:11:00.19,0:11:05.71,Default,,0,0,0,,الصلاة والسلام، قال هذه الكلمات العظيمة الجامعة التي
Dialogue: 0,0:11:05.71,0:11:11.23,Default,,0,0,0,,جمعت الدين كلها، لأن الدين يقوم على هذه الأصول الثلاثة
Dialogue: 0,0:11:11.23,0:11:15.85,Default,,0,0,0,,التي ذكرها عمر رضي الله عنه
Dialogue: 0,0:11:15.85,0:11:22.51,Hadith,,0,0,0,,«قال رضينا بالله ربا وبالإسلام دينا وبمحمد صلى الله عليه وسلم رسولا» [صحيح البخاري (6362)]
Dialogue: 0,0:11:23.51,0:11:28.80,Default,,0,0,0,,وعن هذه الثلاثة يسأل كل إنسان
Dialogue: 0,0:11:28.80,0:11:31.25,Default,,0,0,0,,إذا أدرج في قبله فإنه
Dialogue: 0,0:11:31.25,0:11:34.50,Hadith,,0,0,0,,«يأتيه ملكان فيقعدانه» [صحيح مسلم (7216)]
Dialogue: 0,0:11:34.50,0:11:35.23,Default,,0,0,0,,ويسألاني
Dialogue: 0,0:11:35.23,0:11:39.19,Hadith,,0,0,0,,«من ربك وما دينك ومن نبيك» [سنن أبي داود (4753)]
Dialogue: 0,0:11:39.19,0:11:40.75,Default,,0,0,0,,صلى الله عليه وسلم
Dialogue: 0,0:11:42.95,0:11:48.07,Default,,0,0,0,,ويفوز بصحة الجواب على
Dialogue: 0,0:11:48.07,0:11:50.00,Default,,0,0,0,,هذا السؤال أهل الرضا
Dialogue: 0,0:11:50.00,0:11:51.80,Ayah,,0,0,0,,﴿في هذه الحياة الدنيا﴾ [آل عمران: 117]
Dialogue: 0,0:11:51.80,0:11:57.92,Hadith,,0,0,0,,«بالله رباً وبالإسلام ديناً وبمحمد صلى الله عليه وسلم رسوله» [صحيح البخاري (6362)]
Dialogue: 0,0:11:59.54,0:12:05.45,Default,,0,0,0,,وهذه الكلمات يشرع للمسلم أن يقولها قولاً
Dialogue: 0,0:12:05.45,0:12:10.51,Default,,0,0,0,,متكرراً في أيامه مع سماعه لكل أذن، إذا
Dialogue: 0,0:12:10.51,0:12:15.28,Default,,0,0,0,,قال المؤذن أشهد أن لا إله إلا الله، أشهد أن محمد رسول
Dialogue: 0,0:12:15.28,0:12:20.09,Default,,0,0,0,,الله يقول بعد إجابته للمؤذن في هذا التشهد يقول
Dialogue: 0,0:12:20.09,0:12:26.89,Hadith,,0,0,0,,«رضيت بالله رباً وبالإسلام ديناً ومحمد صلى الله عليه وسلم رسولاً» [صحيح البخاري (7294)]
Dialogue: 0,0:12:26.89,0:12:32.25,Default,,0,0,0,,مجدداً إيمانه ورضاه بالله سبحانه وتعالى رباً
Dialogue: 0,0:12:32.25,0:12:38.19,Default,,0,0,0,,وبالإسلام ديناً ومحمد صلى الله عليه وسلم رسولاً
Dialogue: 0,0:12:38.51,0:12:43.75,Default,,0,0,0,,قال فسئل عن صيام الدهر،
Dialogue: 0,0:12:43.75,0:12:48.80,Default,,0,0,0,,أي عن من
Dialogue: 0,0:12:48.80,0:12:54.07,Default,,0,0,0,,يصوم الدهر، يصوم ولا يغطر، يصوم أياما وكلها دون أن يغطر، سئل
Dialogue: 0,0:12:54.07,0:12:54.69,Default,,0,0,0,,عن ذلك
Dialogue: 0,0:12:54.69,0:12:57.63,Hadith,,0,0,0,,«صلوات الله وسلامه عليه قال» [رياض الصالحين (1275)]
Dialogue: 0,0:12:57.63,0:13:03.73,Hadith,,0,0,0,,«لا صام ولا أفطر، أو ما صام وما أفطر،» [صحيح مسلم (2747)]
Dialogue: 0,0:13:03.73,0:13:08.73,Default,,0,0,0,,شكا الراوي، قال لا صام ولا أفطر، ما أفطر أو ما
Dialogue: 0,0:13:08.73,0:13:15.04,Default,,0,0,0,,صام وما أفطر، أي من يصوم الدهر، لأنه
Dialogue: 0,0:13:15.04,0:13:20.07,Default,,0,0,0,,لم يحصل له فضل الصوم للمخالفة، لأنه لم
Dialogue: 0,0:13:20.07,0:13:25.25,Default,,0,0,0,,يحصل له فضل الصوم بسبب المخالفة، المخالفة
Dialogue: 0,0:13:25.25,0:13:30.85,Default,,0,0,0,,للهدي، هدي النبي الكريم عليه الصلاة والسلام، وفي مثل هذا المقام قال
Dialogue: 0,0:13:30.85,0:13:31.88,Default,,0,0,0,,صلى الله عليه وسلم
Dialogue: 0,0:13:31.88,0:13:35.14,Hadith,,0,0,0,,«ومن رغب عن سنتي فليس مني،» [صحيح البخاري (5063)]
Dialogue: 0,0:13:35.14,0:13:40.57,Default,,0,0,0,,قال فإني أصوم وأفضل، قال ومن رغب عن سنتي فليس مني،
Dialogue: 0,0:13:40.57,0:13:45.95,Default,,0,0,0,,فلم يحصل أجرى الصوم بسبب المخالفة، وما
Dialogue: 0,0:13:45.95,0:13:47.69,Default,,0,0,0,,أفضل لأنه أمسك،
Dialogue: 0,0:13:48.62,0:13:54.11,Default,,0,0,0,,فليس هو بالمفضر وليس هو أيضا بالمحصل لأجل الصيام بسبب
Dialogue: 0,0:13:54.11,0:13:58.35,Default,,0,0,0,,مخالفته، هذا معنى قول عليه الصلاة والسلام
Dialogue: 0,0:13:58.35,0:14:08.33,Hadith,,0,0,0,,«ما صام وما أبضر، قال فسئل عن صيام يومين وإفطار يوم، يعني أن يداوم على …»
Dialogue: 0,0:14:08.33,0:14:14.37,Hadith,,0,0,0,,«… ذلك يصوم يومين ويفطر يوم، قال عليه الصلاة والسلام ومن يطيق ذلك، …»
Dialogue: 0,0:14:14.37,0:14:22.49,Hadith,,0,0,0,,«… قال وسئل عن صوم يوم وإفطار يومين، قال ليت أن الله عز وجل قوان لذلك، …»
Dialogue: 0,0:14:22.49,0:14:33.59,Hadith,,0,0,0,,«… قال وسئل عن صيام يوم وإفطار يوم، قال ذاك صوم أخي داود عليه السلام، …»
Dialogue: 0,0:14:33.59,0:14:45.49,Hadith,,0,0,0,,«… قال وسئل عن صيام يوم الأثنين، فقال ذاك يوم ولدت فيه، ويوم بعدت وأنزل علي فيه،» [صحيح مسلم (2747)]
Dialogue: 0,0:14:47.87,0:14:53.12,Default,,0,0,0,,وهذا فيه فضل صيام هذا اليوم يوم الاثنين
Dialogue: 0,0:14:53.12,0:14:58.83,Default,,0,0,0,,من كل أسبوع، وذكر عليه الصلاة والسلام أنه
Dialogue: 0,0:14:58.83,0:15:00.97,Default,,0,0,0,,يوم ولد فيه صلى الله
Dialogue: 0,0:15:00.97,0:15:03.00,Ayah,,0,0,0,,﴿وسلم عليه، ويوم﴾ [مريم: 15]
Dialogue: 0,0:15:03.00,0:15:08.85,Default,,0,0,0,,أنزل عليه فيه آية الوحي صلى الله وسلم عليه،
Dialogue: 0,0:15:08.85,0:15:09.11,Default,,0,0,0,,ويوم
Dialogue: 0,0:15:09.11,0:15:19.54,Hadith,,0,0,0,,«بعثه الله تبارك وتعالى فيه قال فصوم ثلاثة أيام من كل شهر ورمضان إلى رمضان صوم الدهر» [صحيح مسلم (2747)]
Dialogue: 0,0:15:19.54,0:15:22.76,Default,,0,0,0,,وهذا فيه فضيلة المواضبة على
Dialogue: 0,0:15:22.76,0:15:24.38,Ayah,,0,0,0,,﴿صيام ثلاثة أيام﴾ [البقرة: 196]
Dialogue: 0,0:15:24.38,0:15:25.23,Default,,0,0,0,,من كل شهر
Dialogue: 0,0:15:26.47,0:15:31.73,Default,,0,0,0,,ولا يشترط في هذه الأيام الثلاثة كما سيأتي بيان
Dialogue: 0,0:15:31.73,0:15:36.83,Default,,0,0,0,,ذلك أن تجمع في وقت من الشهر متتالية
Dialogue: 0,0:15:37.45,0:15:37.83,Default,,0,0,0,,الصوم
Dialogue: 0,0:15:37.83,0:15:40.26,Hadith,,0,0,0,,«في أوله أو أوسطه أو آخره» [سنن أبي داود (769)]
Dialogue: 0,0:15:40.26,0:15:45.26,Default,,0,0,0,,لا يشترط أن يؤت بها مجتمعاً، بل لو صامها مجتمعة في أول
Dialogue: 0,0:15:45.26,0:15:50.57,Default,,0,0,0,,الشهر أو في وسطه أو في آخره، أو صامها متفرقة في
Dialogue: 0,0:15:50.57,0:15:54.45,Default,,0,0,0,,أثناء الشهر، فإنه يكون بذلك حصل فضيلة
Dialogue: 0,0:15:54.45,0:15:56.59,Ayah,,0,0,0,,﴿صيام ثلاثة أيام﴾ [البقرة: 196]
Dialogue: 0,0:15:56.59,0:16:01.95,Default,,0,0,0,,من كل شهر، وسيأتي ما يوضح ذلك في حديث أم المؤمنين عائشة
Dialogue: 0,0:16:01.95,0:16:03.19,Default,,0,0,0,,رضي الله عنها،
Dialogue: 0,0:16:03.19,0:16:13.54,Hadith,,0,0,0,,«قال فصوم ثلاثة أيام من كل شهر ورمضان إلى رمضان صوم الدهر،» [صحيح مسلم (2747)]
Dialogue: 0,0:16:13.54,0:16:19.04,Default,,0,0,0,,لأن من يصوم ثلاثة أيام من كل شهر فإن الحسنة بعشر
Dialogue: 0,0:16:19.04,0:16:20.42,Default,,0,0,0,,أمثالها،
Dialogue: 0,0:16:20.42,0:16:26.99,Hadith,,0,0,0,,«فمن صام ثلاثة أيام من كل شهر» [سنن النسائي (2410)]
Dialogue: 0,0:16:26.99,0:16:31.99,Default,,0,0,0,,واضب عليها مع صيامي لشهر رمضان، فكأنما
Dialogue: 0,0:16:31.99,0:16:36.66,Default,,0,0,0,,صاب الدهر كله، كأنه حياته كلها أمضها صائماً
Dialogue: 0,0:16:37.61,0:16:41.50,Default,,0,0,0,,وعلى من فضل الله سبحانه وتعالى يصوم المرأ فقط
Dialogue: 0,0:16:41.50,0:16:42.19,Ayah,,0,0,0,,﴿ثلاثة أيام﴾ [البقرة: 196]
Dialogue: 0,0:16:42.19,0:16:47.23,Default,,0,0,0,,من كل شهر يوظب عليها ويكتب له كأنه صام حياته كلها،
Dialogue: 0,0:16:47.23,0:16:48.54,Hadith,,0,0,0,,«كأنما صام الدهر» [سنن أبي داود (2433)]
Dialogue: 0,0:16:48.54,0:16:52.09,Default,,0,0,0,,يعني كأنما صام حياته كلها،
Dialogue: 0,0:16:52.09,0:17:00.85,Hadith,,0,0,0,,«قال فسئل عن صوم عاشراء قال يكثر السنة الماضية،» [صحيح مسلم (2747)]
Dialogue: 0,0:17:00.85,0:17:06.17,Default,,0,0,0,,يعني السنة التي قبلها، ويوم عاشراء هو اليوم العاشر من
Dialogue: 0,0:17:06.17,0:17:06.60,Default,,0,0,0,,شهر
Dialogue: 0,0:17:07.17,0:17:12.71,Default,,0,0,0,,من شهر الله المحرم ومر فيه ترجمة خاصة عند المصنف
Dialogue: 0,0:17:12.71,0:17:13.71,Default,,0,0,0,,رحمه الله عنه
Dialogue: 0,0:17:37.08,0:17:37.10,Default,,0,0,0,,في
Dialogue: 0,0:17:37.10,0:17:38.34,Hadith,,0,0,0,,«أيام الشهر يصوم» [صحيح مسلم (2744)]
Dialogue: 0,0:17:38.34,0:17:43.39,Default,,0,0,0,,انفرد به مسلم، وقد تقدم في صلاة الضحى حديث أبي هريرة رضي
Dialogue: 0,0:17:43.39,0:17:47.10,Default,,0,0,0,,الله عنه أو صاني خليلي صلى الله عليه وسلم بثلاث
Dialogue: 0,0:17:47.10,0:17:48.99,Ayah,,0,0,0,,﴿صيام ثلاثة أيام﴾ [البقرة: 196]
Dialogue: 0,0:17:48.99,0:17:53.84,Default,,0,0,0,,من كل شهر، الحديث وهو متفق عليه، وحديث أبي الدرداء رضي الله
Dialogue: 0,0:17:53.84,0:17:55.99,Default,,0,0,0,,عنه في ذلك وهو من أفراد مسلم
Dialogue: 0,0:17:57.69,0:18:01.52,Default,,0,0,0,,ثم أورد رحمه الله تعالى هذا الحديث أن
Dialogue: 0,0:18:01.52,0:18:04.95,Hadith,,0,0,0,,«معاذة رضي الله عنها سألت عائشة» [صحيح مسلم (763)]
Dialogue: 0,0:18:04.95,0:18:09.75,Default,,0,0,0,,رضي الله عنها زوج النبي صلى الله عليه وسلم أكان رسول الله
Dialogue: 0,0:18:09.75,0:18:11.56,Default,,0,0,0,,صلى الله عليه وسلم
Dialogue: 0,0:18:11.56,0:18:19.17,Hadith,,0,0,0,,«يصوم من كل شهر ثلاثة أيام؟ قالت نعم، فقالت لها من أي شهر كان يصوم؟» [صحيح مسلم (2744)]
Dialogue: 0,0:18:19.08,0:18:24.56,Default,,0,0,0,,ومثل هذه السؤالات يسألون عنها حرصاً على الاتباع،
Dialogue: 0,0:18:24.56,0:18:30.19,Default,,0,0,0,,والاهتداء بهدي النبي عليه الصلاة والسلام ليست
Dialogue: 0,0:18:30.19,0:18:35.28,Default,,0,0,0,,مجرد معلومات يحصلونها، وإنما كانوا يسألون عن
Dialogue: 0,0:18:35.28,0:18:39.41,Default,,0,0,0,,هديه من أجل اتباعه ونئتسائي به،
Dialogue: 0,0:18:39.41,0:18:46.75,Ayah,,0,0,0,,﴿لقد كان لكم في رسول الله أسوة حسنة لمن كان يرجو الله واليوم الآخر وذكر الله كثيراً﴾ [الأحزاب: 21]
Dialogue: 0,0:18:47.39,0:18:52.60,Default,,0,0,0,,ومثل هذه السؤالات توضح لنا الهدف من دراسة فضائل الأعمال،
Dialogue: 0,0:18:52.60,0:18:57.60,Default,,0,0,0,,فإن فضائل الأعمال ومدارستها ومذكرتها
Dialogue: 0,0:18:57.60,0:19:02.76,Default,,0,0,0,,من أغم المعونة للعبد على العناية بالأعمال الفاضلة،
Dialogue: 0,0:19:02.76,0:19:07.47,Default,,0,0,0,,قالت فقلت لها من أي شهر كان يصوم؟
Dialogue: 0,0:19:08.47,0:19:12.58,Default,,0,0,0,,يعني هذه الثلاث من أي شهر كان يصوم، هل يصوم في أول
Dialogue: 0,0:19:12.58,0:19:15.50,Default,,0,0,0,,الشهر؟ أو يصوم في وسطه؟
Dialogue: 0,0:19:15.50,0:19:16.99,Default,,0,0,0,,أو يصوم في آخر؟
Dialogue: 0,0:19:16.99,0:19:29.45,Hadith,,0,0,0,,«من أي شهر كان يصوم؟ فقالت عائشة رضي الله عنها لم يكن يبالي من أي شهر يصوم،» [رياض الصالحين (582)]
Dialogue: 0,0:19:29.45,0:19:32.71,Default,,0,0,0,,بمعنى أنه تارة يصوم
Dialogue: 0,0:19:32.71,0:19:35.99,Hadith,,0,0,0,,«من أوله، وتارة من وسطه، وتارة» [سنن النسائي (1681)]
Dialogue: 0,0:19:35.99,0:19:41.21,Default,,0,0,0,,من آخره، قد تخطيه من آقره، فهذه الأيام
Dialogue: 0,0:19:41.21,0:19:46.39,Default,,0,0,0,,الثلاثة التي ذكرت أم المؤنين عائشة أن النبي عليه الصلاة
Dialogue: 0,0:19:46.39,0:19:47.86,Default,,0,0,0,,والسلام يواضب عليها
Dialogue: 0,0:20:18.22,0:20:23.29,Default,,0,0,0,,من كل شهر، وهذا لا يقال، ولم يأتي ما
Dialogue: 0,0:20:23.29,0:20:28.14,Default,,0,0,0,,يدل عليه، وإنما المراد بذلك
Dialogue: 0,0:20:28.14,0:20:30.90,Ayah,,0,0,0,,﴿صيام ثلاثة أيام﴾ [البقرة: 196]
Dialogue: 0,0:20:30.90,0:20:31.81,Default,,0,0,0,,من كل شهر
Dialogue: 0,0:20:33.29,0:20:34.09,Default,,0,0,0,,سواء كانت في
Dialogue: 0,0:20:34.09,0:20:37.55,Hadith,,0,0,0,,«أوله، أو في وسطه،» [صحيح البخاري (2127)]
Dialogue: 0,0:20:37.55,0:20:42.90,Default,,0,0,0,,أو في آخره، وسواء أيضاً صامها المسلم
Dialogue: 0,0:20:42.90,0:20:50.00,Default,,0,0,0,,متفرقة أو مجتمعة، فإنه
Dialogue: 0,0:20:50.00,0:20:51.81,Default,,0,0,0,,بذلك يكون حصل فضيلة
Dialogue: 0,0:20:51.81,0:21:00.38,Hadith,,0,0,0,,«الصيام ثلاثة أيام من كل شهر، كأنما صام الدهر، وصيام» [سنن النسائي (2420)]
Dialogue: 0,0:21:00.38,0:21:05.01,Default,,0,0,0,,ثلاثة أيام من كل شهر وردت فيه فضاء العديدة، فلا يشترط في
Dialogue: 0,0:21:05.01,0:21:07.35,Default,,0,0,0,,صيامها أن يؤتى بها مجتمعاً لا
Dialogue: 0,0:21:07.35,0:21:10.00,Hadith,,0,0,0,,«في أوله ولا في وسطه ولا في آخره،» [سنن أبي داود (769)]
Dialogue: 0,0:21:10.00,0:21:15.40,Default,,0,0,0,,بل سواء جاء بها مجتمعة أو جاء بها متفرقة فإنه
Dialogue: 0,0:21:15.40,0:21:20.33,Default,,0,0,0,,يكون بذلك حصل الفضيلة، كما قالت أم المؤمنين عائشة رضي الله عنه
Dialogue: 0,0:21:20.33,0:21:21.00,Default,,0,0,0,,في هذا الحديث
Dialogue: 0,0:21:21.00,0:21:26.38,Hadith,,0,0,0,,«لم يكن يغالي من أي أيام الشهر يصوم.» [صحيح مسلم (2744)]
Dialogue: 0,0:21:28.85,0:21:34.50,Default,,0,0,0,,ويؤكد هذا المعنى ما تقدم عند المصنف حديث أبي
Dialogue: 0,0:21:34.50,0:21:35.46,Default,,0,0,0,,هريرة قال
Dialogue: 0,0:21:35.46,0:21:39.85,Hadith,,0,0,0,,«أوصاني خليلي بثلاثة أيام، سيام ثلاثة أيام من كل شهر،» [صحيح البخاري (1178)]
Dialogue: 0,0:21:39.85,0:21:41.85,Default,,0,0,0,,ونحو أيضا حديث بالدردان
Dialogue: 0,0:21:43.79,0:21:49.40,Default,,0,0,0,,فهذه الأحاديث كلها جاء فيها تفضيل
Dialogue: 0,0:21:49.40,0:21:56.09,Default,,0,0,0,,أو فضل سيام ثلاثة أيام من كل شهر دون أن يعين
Dialogue: 0,0:21:56.09,0:22:01.40,Default,,0,0,0,,هل هو في الأول أو في الوسط أو
Dialogue: 0,0:22:01.40,0:22:05.03,Default,,0,0,0,,في آخر الشهر لكن جاء من حديث أبي ذر رضي الله عنه
Dialogue: 0,0:22:05.03,0:22:08.79,Default,,0,0,0,,أن النبي صلى الله عليه وسلم قال
Dialogue: 0,0:22:08.79,0:22:26.61,Hadith,,0,0,0,,«إذا صمت من الشهر ثلاثاً فصم ثلاثاً هذا الحديث أفاد فضل صيام البيض التي في وسط الشهر، …»
Dialogue: 0,0:22:26.61,0:22:29.59,Hadith,,0,0,0,,«… ثلاثة عشرة وأربعة عشرة وخمسة عشرة،» [رياض الصالحين (583)]
Dialogue: 0,0:22:29.59,0:22:34.75,Default,,0,0,0,,وتسمى أيام البيض لأنها أيام بدار للقمر واكتمال نوره
Dialogue: 0,0:22:34.75,0:22:40.42,Default,,0,0,0,,وضياءه، فجاء في هذا الحديث ما
Dialogue: 0,0:22:40.42,0:22:40.57,Default,,0,0,0,,يدل على فضل هذه الحديث، فهي أفاد فضل
Dialogue: 0,0:22:40.57,0:22:40.64,Hadith,,0,0,0,,«عشرة وخمسة عشرة،» [جامع الترمذي (761)]
Dialogue: 0,0:22:40.64,0:22:40.74,Default,,0,0,0,,فهي أفاد فضل صيام البيض.
Dialogue: 0,0:22:40.01,0:22:45.03,Default,,0,0,0,,ما يدل على فضل هذه الأيام، لكن من أراد
Dialogue: 0,0:22:45.03,0:22:45.31,Default,,0,0,0,,أن
Dialogue: 0,0:22:45.31,0:22:48.88,Hadith,,0,0,0,,«يصوم ثلاثة الأيام من أول الشهر» [سنن أبي داود (507)]
Dialogue: 0,0:22:48.88,0:22:53.92,Default,,0,0,0,,أو من وسطه التي يلبيض أو من آخره، أو يصومها
Dialogue: 0,0:22:53.92,0:22:58.98,Default,,0,0,0,,متفرقة أو مجتمعة، الأمر في ذلك واسع، يكون قد أدرك
Dialogue: 0,0:22:58.98,0:22:59.68,Default,,0,0,0,,فضيلة
Dialogue: 0,0:22:59.68,0:23:04.16,Hadith,,0,0,0,,«صيام ثلاثة الأيام من كل شهر» [صحيح البخاري (1981)]
Dialogue: 0,0:23:05.92,0:23:06.18,Default,,0,0,0,,يقول
Dialogue: 0,0:23:06.18,0:23:08.35,Hadith,,0,0,0,,«الشيخ عبد العزيز بن باز» [بلوغ المرام (209)]
Dialogue: 0,0:23:08.35,0:23:13.74,Default,,0,0,0,,رحمة الله عليه حول هذه المسألة، قال الأحاديث
Dialogue: 0,0:23:13.74,0:23:19.18,Default,,0,0,0,,الصحيحة المستفيضة عن رسول الله صلى الله عليه وسلم
Dialogue: 0,0:23:19.18,0:23:24.66,Default,,0,0,0,,ليس فيها ذكر البيض بني الصوم متشاء، كما
Dialogue: 0,0:23:24.66,0:23:30.18,Default,,0,0,0,,في حديث عبد الله بن عمر في الصحيحين، وأبي هريرة في الصحيحين،
Dialogue: 0,0:23:30.18,0:23:34.57,Default,,0,0,0,,وحديث أبي الدردا في مسلم، وهي أصح بكثرة قال الله صلى الله
Dialogue: 0,0:23:34.57,0:23:35.96,Default,,0,0,0,,عليه وسلم. مرد الرسولة من حديث أبي ذر.
Dialogue: 0,0:23:35.96,0:23:49.57,Default,,0,0,0,,فإذا
Dialogue: 0,0:23:49.57,0:23:49.94,Default,,0,0,0,,صام
Dialogue: 0,0:23:49.94,0:23:50.88,Ayah,,0,0,0,,﴿ثلاثة أيام﴾ [البقرة: 196]
Dialogue: 0,0:23:50.88,0:23:57.59,Default,,0,0,0,,من كل شهر في العشر الأول، أو في العشر الأخيرة،
Dialogue: 0,0:23:57.59,0:24:00.68,Default,,0,0,0,,حصل له الأجر.
Dialogue: 0,0:24:01.38,0:24:07.25,Default,,0,0,0,,وإذا وافق أيام البيض فذلك أفضل جمعاً
Dialogue: 0,0:24:07.25,0:24:13.09,Default,,0,0,0,,بين الأحاديث
Dialogue: 0,0:24:13.09,0:24:15.46,Default,,0,0,0,,كلها، انتهى كلامه رحمه الله
Dialogue: 0,0:24:16.22,0:24:18.44,Default,,0,0,0,,وفضيلة كما تقدم تحصل
Dialogue: 0,0:24:18.44,0:24:21.27,Ayah,,0,0,0,,﴿بصيام ثلاثة أيام﴾ [البقرة: 196]
Dialogue: 0,0:24:21.27,0:24:26.90,Default,,0,0,0,,من كل سهر، سواء صامها متذرقة أو صامها
Dialogue: 0,0:24:26.90,0:24:32.05,Default,,0,0,0,,مجتمعة، فإنه يحصل هذه الفضيلة، حتى مثلا من كان
Dialogue: 0,0:24:32.05,0:24:38.92,Default,,0,0,0,,يواضب على صيام الاثنين، فإنه
Dialogue: 0,0:24:38.92,0:24:42.85,Default,,0,0,0,,حصل هذه الفضيلة وهي
Dialogue: 0,0:24:42.85,0:24:45.24,Ayah,,0,0,0,,﴿صيام ثلاثة أيام،﴾ [البقرة: 196]
Dialogue: 0,0:24:45.57,0:24:51.03,Default,,0,0,0,,وإذا خص ثلاثة أيام وصامها في أيام
Dialogue: 0,0:24:51.03,0:24:56.22,Default,,0,0,0,,البيض فهذا أفضل كما أشار الشيخ رحمه الله تعالى
Dialogue: 0,0:24:57.11,0:24:58.44,Default,,0,0,0,,ونسأل الله الكريم
Dialogue: 0,0:24:58.44,0:24:59.98,Ayah,,0,0,0,,﴿رب العرش العظيم﴾ [التوبة: 129]
Dialogue: 0,0:24:59.98,0:25:05.35,Default,,0,0,0,,أن ينفعنا أجمعين بما علمنا وأن يزيدنا علما
Dialogue: 0,0:25:05.35,0:25:10.59,Default,,0,0,0,,وأن يصلح لنا شأننا كله وأن لا يكلنا إلى أنفسنا
Dialogue: 0,0:25:10.59,0:25:13.22,Default,,0,0,0,,طرف التعين، وأن يهدينا
Dialogue: 0,0:25:13.22,0:25:15.35,Ayah,,0,0,0,,﴿إليه صراطا مستقيمة،﴾ [النساء: 175]
Dialogue: 0,0:25:15.35,0:25:21.07,Default,,0,0,0,,وأن يصلح لنا شننا كله، وأن لا يكلنا إلى أنفسنا طرف
Dialogue: 0,0:25:21.07,0:25:26.64,Default,,0,0,0,,التعين، وأن يغفر لنا ولوالدين ولمشايخنا، أولاة أمرنا،
Dialogue: 0,0:25:26.64,0:25:30.09,Ayah,,0,0,0,,﴿وللمسلمين والمسلمات، والمؤمنين والمؤمنات،﴾ [الأحزاب: 35]
Dialogue: 0,0:25:30.09,0:25:32.07,Ayah,,0,0,0,,﴿الأحياء منهم الأموات،﴾ [فاطر: 22]
Dialogue: 0,0:25:32.07,0:25:33.66,Default,,0,0,0,,اللهم آتي نقوسنا
Dialogue: 0,0:25:33.66,0:25:39.72,Hadith,,0,0,0,,«تقواها، وزكها، أنت خير من زكاها، أنت ولي، سمع الله تليمًا ولا تليمًا لِم الشَّبِ وَمَالْهَا وَمَولَاهَا وَمَوْلَاهَا اللَّهُمَّ إِنَّا» [صحيح مسلم (6906)]
Dialogue: 0,0:25:39.72,0:25:43.33,Default,,0,0,0,,نَسْتَلُكَ الْهُدَى وَالتُّقَى وَالْعِفَّةَ وَالْغِنَاءَ
Dialogue: 0,0:25:43.33,0:25:47.53,Hadith,,0,0,0,,«اللَّهُمَّ إِنَّا نَسْتَلُكَ الثَّبَاتَ فِي الْأَمْرَ وَالْعَزِيمَةَ عَلَى الْرُشْدِ» [سنن النسائي (1304)]
Dialogue: 0,0:25:47.53,0:25:48.50,Default,,0,0,0,,وَنَسْتَلُكَ
Dialogue: 0,0:25:48.50,0:26:07.53,Hadith,,0,0,0,,«مُوجِبَاتِ رَحْمَتِكُ وَعَزَائِمَ مَغْفِرَتِك» [جامع الترمذي (479)]
Dialogue: 0,0:26:08.09,0:26:13.64,Default,,0,0,0,,الله
Dialogue: 0,0:26:13.64,0:26:35.79,Default,,0,0,0,,تعالى.
Dialogue: 0,0:26:37.88,0:26:41.77,Hadith,,0,0,0,,«أشهد أن لا إله إلا أنت، أستغفرك وأتوب إليك،» [سنن أبي داود (4859)]
Dialogue: 0,0:26:41.77,0:26:44.48,Hadith,,0,0,0,,«اللهم صلِّ وسلِّم على عبدك ورسولك» [صحيح البخاري (4798)]
Dialogue: 0,0:26:44.48,0:26:47.40,Default,,0,0,0,,نبينا محمد وآله وصحبه.
Dialogue: 0,0:26:47.50,0:26:49.05,Default,,0,0,0,,رزاكم الله خيراً.
