Dialogue: 0,0:00:00.02,0:00:09.77,Hadith,,0,0,0,,"إن الحمد لله نحمده ونستعينه ونستغفره، ونعوذ بالله من شرور أنفسنا ومن سيئات أعمالنا، …"
Dialogue: 0,0:00:09.77,0:00:15.88,Hadith,,0,0,0,,"… من يهديه الله فلا مضل له، ومن يضلل فلا هادي له،" [سنن ابن ماجه (1892)]
Dialogue: 0,0:00:15.88,0:00:24.42,Ayah,,0,0,0,,(يا أيها الذين آمنوا اتقوا الله حق ثقاته، ولا تموتن إلا وأنتم مسلمون) [آل عمران: 102]
Dialogue: 0,0:00:25.19,0:00:33.50,Ayah,,0,0,0,,(يا أيها الناس اتقوا ربكم الذي خلقكم من نفس واحدة، وخلق منها زوجها، …)
Dialogue: 0,0:00:33.50,0:00:47.24,Ayah,,0,0,0,,(… وبث منهما رجالا كثيرا ونساء، واتقوا الله الذي تساءلون به والأرحم، إن الله كان عليكم رقيبا) [النساء: 1]
Dialogue: 0,0:00:47.56,0:00:53.46,Ayah,,0,0,0,,(يا أيها الذين آمنوا اتقوا الله وقولوا قولاً سديداً) [الأحزاب: 70]
Dialogue: 0,0:00:53.46,0:01:03.29,Ayah,,0,0,0,,(يصلح لكم أعمالكم ويغفر لكم ذنوبكم ومن يطع الله ورسوله فقد فاز فوزاً عظيماً) [الأحزاب: 71]
Dialogue: 0,0:01:03.67,0:01:04.42,Default,,0,0,0,,أما بعد
Dialogue: 0,0:01:04.42,0:01:20.37,Hadith,,0,0,0,,"فإن أصدق الحديث كتاب الله، وأحسن الهدي هدي محمد صلى الله عليه وسلم، وشر الأمور محدثاتها، وكل محدثة بدعة، وكل بدعة ضلالة" [سنن النسائي (1578)]
Dialogue: 0,0:01:21.01,0:01:27.06,Default,,0,0,0,,أيها المؤمنون إن تقوى الله سفينة نجاتكم وعروة
Dialogue: 0,0:01:27.06,0:01:29.98,Default,,0,0,0,,أمانكم ألا فاتقوا الله
Dialogue: 0,0:01:29.98,0:01:42.00,Ayah,,0,0,0,,(يا أيها الذين آمنوا اتقوا الله ولتنظر نفس ما قدمت لغد واتقوا الله إن الله صبير بما تعملون) [الحشر: 18]
Dialogue: 0,0:01:42.68,0:01:47.87,Default,,0,0,0,,أيها المؤمنون، إن أشرف الناس في الناس مقاما، وأعلاهم
Dialogue: 0,0:01:47.87,0:01:53.04,Default,,0,0,0,,عندهم منزله، هم ملوكهم، وإن أحدنا إذا سمع
Dialogue: 0,0:01:53.04,0:01:58.57,Default,,0,0,0,,نداءً من ملك يعظمه، بادر إليه، فأرخى له سمعه،
Dialogue: 0,0:01:58.57,0:02:03.98,Default,,0,0,0,,وجمع عليه قلبه، وأنصت إلى ما يقول، وإن أعظم
Dialogue: 0,0:02:03.98,0:02:09.24,Default,,0,0,0,,الملوك ملكا، وأرفعهم رتبةً ومنزله، هو الله
Dialogue: 0,0:02:09.24,0:02:14.25,Default,,0,0,0,,سبحانه وتعالى، فهو ملك الملوك الذي لا
Dialogue: 0,0:02:14.25,0:02:20.18,Default,,0,0,0,,يزول ولا يحول، وإن الله سبحانه وتعالى نادانا
Dialogue: 0,0:02:20.18,0:02:25.18,Default,,0,0,0,,جنس الإنسان في موضعين من القرآن نداءين
Dialogue: 0,0:02:25.18,0:02:30.63,Default,,0,0,0,,عظيمين ينبغي أن يُبصِر المؤمن منزلة هذين النداءين
Dialogue: 0,0:02:30.63,0:02:36.59,Default,,0,0,0,,فيه، وأن يُلخِي إليهما سمعه، ويُصغِي إليهما بقلبه،
Dialogue: 0,0:02:36.59,0:02:38.90,Default,,0,0,0,,ويتفحَّص حاله فيهما
Dialogue: 0,0:02:39.36,0:02:43.09,Default,,0,0,0,,فأما الأول منهما فقوله تعالى
Dialogue: 0,0:02:43.09,0:02:47.87,Ayah,,0,0,0,,(يا أيها الإنسان ما غرك بربك الكريم) [الانفطار: 6]
Dialogue: 0,0:02:47.87,0:02:51.36,Ayah,,0,0,0,,(الذي خلقك فسواك فعدلك) [الانفطار: 7]
Dialogue: 0,0:02:51.36,0:02:55.62,Ayah,,0,0,0,,(في أي صورة ما شاء ركبك،) [الانفطار: 8]
Dialogue: 0,0:02:55.62,0:02:58.69,Default,,0,0,0,,وأما الثاني فقوله تعالى
Dialogue: 0,0:02:58.69,0:03:05.74,Ayah,,0,0,0,,(يا أيها الإنسان إنك كادح إلى ربك كدحا فملاقيه) [الانشقاق: 6]
Dialogue: 0,0:03:06.21,0:03:09.06,Ayah,,0,0,0,,(أما من أوتي كتابه بيمينه) [الانشقاق: 7]
Dialogue: 0,0:03:09.06,0:03:12.65,Ayah,,0,0,0,,(فسوف يحاسب حسابا يسيرا) [الانشقاق: 8]
Dialogue: 0,0:03:12.65,0:03:16.36,Ayah,,0,0,0,,(وينقلب إلى أهله مسرورا) [الانشقاق: 9]
Dialogue: 0,0:03:16.91,0:03:21.15,Ayah,,0,0,0,,(وأما من أوتي كتابه وراء ظهره) [الانشقاق: 10]
Dialogue: 0,0:03:21.15,0:03:23.52,Ayah,,0,0,0,,(فسوف يدعو ثبورا) [الانشقاق: 11]
Dialogue: 0,0:03:23.52,0:03:25.53,Ayah,,0,0,0,,(ويصلى سعيرا) [الانشقاق: 12]
Dialogue: 0,0:03:25.68,0:03:29.80,Ayah,,0,0,0,,(إنه كان في أهله مسرورا،) [الانشقاق: 13]
Dialogue: 0,0:03:29.80,0:03:32.72,Ayah,,0,0,0,,(إنه ظن أن لن يحور) [الانشقاق: 14]
Dialogue: 0,0:03:32.72,0:03:37.03,Ayah,,0,0,0,,(بلى إن ربه كان به بصراً) [الانشقاق: 15]
Dialogue: 0,0:03:37.44,0:03:42.62,Default,,0,0,0,,فهذان النداءً هم النداءان الموجودان في القرآن
Dialogue: 0,0:03:43.37,0:03:48.34,Default,,0,0,0,,الذان نادى الله سبحانه وتعالى فيهما جنس الإنسان
Dialogue: 0,0:03:48.84,0:03:54.15,Default,,0,0,0,,فالمنادي هو ملك الملوك سبحانه والمنادى هو
Dialogue: 0,0:03:54.15,0:03:55.49,Default,,0,0,0,,أنت أيها الإنسان
Dialogue: 0,0:03:56.18,0:04:01.40,Default,,0,0,0,,وفي كل واحد من النداء معاني جمه، فأما النداء
Dialogue: 0,0:04:01.40,0:04:03.93,Default,,0,0,0,,الأول وهو قوله تعالى
Dialogue: 0,0:04:03.93,0:04:08.72,Ayah,,0,0,0,,(يا أيها الإنسان ما غرَّك بربك الكريم) [الانفطار: 6]
Dialogue: 0,0:04:08.72,0:04:13.84,Default,,0,0,0,,أي أي شيء أصابك بالغرور حتى اغتررت بحارك
Dialogue: 0,0:04:13.84,0:04:18.94,Default,,0,0,0,,من ربك الكريم ثم بيَّن ما أسجاه الله للإنسان من
Dialogue: 0,0:04:18.94,0:04:20.35,Default,,0,0,0,,نعمة، فقال
Dialogue: 0,0:04:20.35,0:04:23.58,Ayah,,0,0,0,,(الذي خلقك فسواك فعدلك) [الانفطار: 7]
Dialogue: 0,0:04:23.58,0:04:25.02,Default,,0,0,0,,في أي صور، في
Dialogue: 0,0:04:25.02,0:04:27.06,Ayah,,0,0,0,,(صورةٍ ما شاء ركبك،) [الانفطار: 8]
Dialogue: 0,0:04:27.06,0:04:32.38,Default,,0,0,0,,أي أن هذا الرب سبحانه وتعالى هو الذي خلق الإنسان
Dialogue: 0,0:04:32.38,0:04:37.41,Default,,0,0,0,,وسواه وعدله، وجعله في خلقٍ تام، كما قال
Dialogue: 0,0:04:37.41,0:04:38.47,Default,,0,0,0,,الله تعالى
Dialogue: 0,0:04:38.47,0:04:42.47,Ayah,,0,0,0,,(لقد خلقنا الإنسان في أحسن تقويم،) [التين: 4]
Dialogue: 0,0:04:42.47,0:04:48.14,Default,,0,0,0,,فأي شيءٍ يغرُّه، وقد جعله الله عز وجل في أحسن صورةٍ،
Dialogue: 0,0:04:48.14,0:04:50.99,Ayah,,0,0,0,,(ولو شاء الله عز وجل لجعله) [الشورى: 8]
Dialogue: 0,0:04:50.99,0:04:55.00,Default,,0,0,0,,في صورةٍ أخرى، فجعله في صورةٍ بهيمةٍ على صورةٍ.
Dialogue: 0,0:04:55.67,0:05:02.62,Default,,0,0,0,,وبيان
Dialogue: 0,0:05:02.62,0:05:08.20,Default,,0,0,0,,هذا المعنى كثيرٌ في القرآن، يذكر الله سبحانه وتعالى خلقه
Dialogue: 0,0:05:08.20,0:05:13.82,Default,,0,0,0,,للإنسان، ليعلم الإنسان أن خالقه ومالكه ومدبِّره
Dialogue: 0,0:05:13.82,0:05:18.23,Default,,0,0,0,,هو الله سبحانه وتعالى، قال الله تعالى
Dialogue: 0,0:05:18.23,0:05:24.75,Ayah,,0,0,0,,(أَوَلَمْ يَرَى الْإِنسَانُ أَنَّا خَلَقْنَاهُ مِنْ نُطْفَةَ فَإِذَا هُوَ خَصِيمٌ) [يس: 77]
Dialogue: 0,0:05:24.75,0:05:25.17,Default,,0,0,0,,مُّمْ مُّا أَوَرْبُّهُ مِنْ أَوَرْبُّهُ مُّهُمْ أَوْرْبُّهُ مُّهُمْ أَوْرْبُّهُ مُّهُم
Dialogue: 0,0:05:25.88,0:05:27.87,Default,,0,0,0,,وقال سبحانه وتعالى
Dialogue: 0,0:05:27.87,0:05:30.56,Ayah,,0,0,0,,(اقرأ باسم ربك الذي خلق) [العلق: 1]
Dialogue: 0,0:05:30.56,0:05:35.99,Default,,0,0,0,,الإنسان من علقاء، وقال سبحانه وتعالى
Dialogue: 0,0:05:35.99,0:05:44.70,Ayah,,0,0,0,,(إنا خلقنا الإنسان من نطفة أمشاج نبتريه، فجعلناه سميعاً بصيراً،) [الإنسان: 2]
Dialogue: 0,0:05:44.70,0:05:45.76,Default,,0,0,0,,وقال تعالى
Dialogue: 0,0:05:45.76,0:05:48.38,Ayah,,0,0,0,,(أيحسب الإنسان أن يُترك) [القيامة: 36]
Dialogue: 0,0:05:48.38,0:05:49.08,Default,,0,0,0,,سُداء،
Dialogue: 0,0:05:49.08,0:05:52.37,Ayah,,0,0,0,,(ألم يكن نطفةً من مني يُمنا،) [القيامة: 37]
Dialogue: 0,0:05:52.00,0:05:57.06,Default,,0,0,0,,فهذا المخلوق الذي يعظم نفسه ويغتر
Dialogue: 0,0:05:57.06,0:06:02.50,Default,,0,0,0,,بما هو عليه مع ربه، الخالق له هو الله، والمالك
Dialogue: 0,0:06:02.50,0:06:07.82,Default,,0,0,0,,له هو الله، والحاكم فيه هو الله، والمدبر له هو
Dialogue: 0,0:06:07.82,0:06:13.00,Default,,0,0,0,,الله، فينبغي للإنسان أن يرتدع عن غيه، وأن يعود إلى
Dialogue: 0,0:06:13.00,0:06:17.47,Default,,0,0,0,,رشده، وأن يعلم أن الله الذي خلقه قال له
Dialogue: 0,0:06:17.93,0:06:22.82,Ayah,,0,0,0,,(يا أيها الإنسان ما غرَّك بربك الكريم) [الانفطار: 6]
Dialogue: 0,0:06:22.82,0:06:26.23,Ayah,,0,0,0,,(الذي خلقك فسواك فعدلك) [الانفطار: 7]
Dialogue: 0,0:06:26.23,0:06:29.64,Ayah,,0,0,0,,(في أي صورة ما شاء ركَّبك،) [الانفطار: 8]
Dialogue: 0,0:06:29.64,0:06:34.76,Default,,0,0,0,,وأما النداء الثاني فهو نداءٌ عظيم يُبَيِّن فيه الله
Dialogue: 0,0:06:34.76,0:06:39.85,Default,,0,0,0,,سبحانه وتعالى حال الإنسان في هذه الدنيا، إذ قال
Dialogue: 0,0:06:39.85,0:06:46.70,Ayah,,0,0,0,,(يا أيها الإنسان إنك كادِحٌ إلى ربك كدحًا فمُلاقيه،) [الانشقاق: 6]
Dialogue: 0,0:06:46.93,0:06:52.41,Default,,0,0,0,,إِنَّكَ عَامِلٌ لِلَّهِ عَزَّ وَجَلَّ عَمَلًا فَمُلاقِيهِ فأنت
Dialogue: 0,0:06:52.41,0:06:57.44,Default,,0,0,0,,مُلاقٍ الله سبحانه وتعالى ليس بينك وبينه
Dialogue: 0,0:06:57.44,0:07:02.97,Default,,0,0,0,,تُرزُمان وأنت مُلاقٍ عَمِلَكَ الذي عَمِلت وعند ذلك
Dialogue: 0,0:07:02.97,0:07:07.88,Default,,0,0,0,,يفترِقُ الناس، كما قال الله سبحانه وتعالى،
Dialogue: 0,0:07:07.88,0:07:10.97,Ayah,,0,0,0,,(فأما من أوتي كتابه بيمينه،) [الانشقاق: 7]
Dialogue: 0,0:07:10.97,0:07:14.37,Ayah,,0,0,0,,(فسوف يحاسب حسابًا يسيرًا،) [الانشقاق: 8]
Dialogue: 0,0:07:14.37,0:07:17.62,Ayah,,0,0,0,,(وينقلب إلى أهله مسورًا،) [الانشقاق: 9]
Dialogue: 0,0:07:17.62,0:07:22.67,Default,,0,0,0,,فيعرض الله عليه سيئاته، ويقرِّره على ذنوبه،
Dialogue: 0,0:07:22.67,0:07:27.75,Default,,0,0,0,,ثم يستوها الله عليه في الآخرة، كما سترها عليه
Dialogue: 0,0:07:27.75,0:07:32.32,Default,,0,0,0,,في الدنيا، وحينئذ يرجع إلى أهله مسوراً،
Dialogue: 0,0:07:32.32,0:07:37.49,Ayah,,0,0,0,,(وأما من أوتي كتابه بشماله من وراء ظهره،) [الانشقاق: 10]
Dialogue: 0,0:07:37.49,0:07:39.87,Ayah,,0,0,0,,(فسوف يدعو ثبوراً،) [الانشقاق: 11]
Dialogue: 0,0:07:39.87,0:07:40.94,Default,,0,0,0,,أي ويلاً،
Dialogue: 0,0:07:40.94,0:07:42.93,Ayah,,0,0,0,,(ويصلى سعيراً،) [الانشقاق: 12]
Dialogue: 0,0:07:42.93,0:07:48.67,Default,,0,0,0,,أي نارًا تترضى، وقد أخبر الله عن حاله فقال إنه
Dialogue: 0,0:07:48.67,0:07:53.85,Default,,0,0,0,,كان في أهله مسوراً، مغترًّا بحاله وماله
Dialogue: 0,0:07:53.85,0:07:58.58,Default,,0,0,0,,وولده، تارِك للعمل لله سبحانه وتعالى،
Dialogue: 0,0:07:58.62,0:08:00.81,Ayah,,0,0,0,,(فسوف يدعو ثبوراً) [الانشقاق: 11]
Dialogue: 0,0:08:00.81,0:08:02.75,Ayah,,0,0,0,,(ويصلى سعيراً) [الانشقاق: 12]
Dialogue: 0,0:08:02.75,0:08:06.20,Ayah,,0,0,0,,(إنه كان في أهله مسروراً) [الانشقاق: 13]
Dialogue: 0,0:08:06.20,0:08:08.56,Ayah,,0,0,0,,(إنه ظن أن لن يحور) [الانشقاق: 14]
Dialogue: 0,0:08:08.56,0:08:12.25,Default,,0,0,0,,أي لن يرجع لله سبحانه وتعالى
Dialogue: 0,0:08:12.25,0:08:15.88,Ayah,,0,0,0,,(بلى إن ربه كان به بصيراً) [الانشقاق: 15]
Dialogue: 0,0:08:15.88,0:08:21.05,Default,,0,0,0,,أي عالماً بحاله وعند ذلك يمتاز الناس كما قال
Dialogue: 0,0:08:21.05,0:08:23.23,Default,,0,0,0,,الله سبحانه وتعالى
Dialogue: 0,0:08:23.23,0:08:27.67,Ayah,,0,0,0,,(أفمن كان مؤمناً كمن كان فاسقاً لا) [السجدة: 18]
Dialogue: 0,0:08:27.67,0:08:28.55,Default,,0,0,0,,يستعود
Dialogue: 0,0:08:29.00,0:08:34.02,Default,,0,0,0,,وأما الذين كفروا فإن عذابهم النار كما أخبر
Dialogue: 0,0:08:34.02,0:08:37.00,Default,,0,0,0,,الله سبحانه وتعالى عنهم،
Dialogue: 0,0:08:37.00,0:08:46.73,Ayah,,0,0,0,,(فيا أيها الإنسان ما غرك بربك الكريم) [الانفطار: 6]
Dialogue: 0,0:08:46.73,0:08:50.11,Ayah,,0,0,0,,(الذي خلقك فسواك فعدلك) [الانفطار: 7]
Dialogue: 0,0:08:50.11,0:08:53.09,Default,,0,0,0,,في أي صورة ما شاركبك
Dialogue: 0,0:08:53.52,0:09:00.38,Ayah,,0,0,0,,(يا أيها الإنسان إنك كادح إلى ربك كدحًا فملاقيه،) [الانشقاق: 6]
Dialogue: 0,0:09:00.38,0:09:04.50,Ayah,,0,0,0,,(فأما من أوتي كتابه بيمينه،) [الانشقاق: 7]
Dialogue: 0,0:09:04.50,0:09:07.71,Ayah,,0,0,0,,(فسوف يحاسب حسابًا يسيرًا،) [الانشقاق: 8]
Dialogue: 0,0:09:07.71,0:09:10.90,Ayah,,0,0,0,,(وينقلب إلى أهله مسورًا،) [الانشقاق: 9]
Dialogue: 0,0:09:10.90,0:09:15.02,Ayah,,0,0,0,,(وأما من أوتي كتابه وراء ظهره،) [الانشقاق: 10]
Dialogue: 0,0:09:15.02,0:09:17.38,Ayah,,0,0,0,,(فسوف يدعو ذبورًا،) [الانشقاق: 11]
Dialogue: 0,0:09:17.38,0:09:19.35,Ayah,,0,0,0,,(ويصلى سعيرًا،) [الانشقاق: 12]
Dialogue: 0,0:09:19.35,0:09:22.59,Ayah,,0,0,0,,(إنه كان في أهله مسورًا،) [الانشقاق: 13]
Dialogue: 0,0:09:23.30,0:09:25.99,Ayah,,0,0,0,,(إنه ظن أن ليحور،) [الانشقاق: 14]
Dialogue: 0,0:09:25.99,0:09:29.75,Ayah,,0,0,0,,(بلى إن ربه كان به بصيرا،) [الانشقاق: 15]
Dialogue: 0,0:09:29.75,0:09:34.12,Default,,0,0,0,,أقول ما تسمعون، وأستغفر الله العلي العظيم لي ولكم فاستغفروه
Dialogue: 0,0:09:34.12,0:09:35.85,Ayah,,0,0,0,,(إنه هو الغفور الرحيم) [يوسف: 98]
Dialogue: 0,0:09:38.28,0:09:43.85,Default,,0,0,0,,الحمد لله حمداً حمداً، والشكر له توالياً وتتراه،
Dialogue: 0,0:09:43.85,0:09:53.52,Hadith,,0,0,0,,"وأشهد أن لا إله إلا الله وحده لا شريك له هو الحق المبين واشهد أن محمدا عبده ورسوله" [صحيح مسلم (554)]
Dialogue: 0,0:09:53.52,0:09:58.16,Default,,0,0,0,,حجة هو على خلقه ورحمته المهدات للعالمين
Dialogue: 0,0:09:58.78,0:10:08.00,Hadith,,0,0,0,,"اللهم صل على محمد وعلى آل محمد، كما صليت على إبراهيم وعلى آل إبراهيم إنك حميدٌ مجيد …"
Dialogue: 0,0:10:08.62,0:10:19.02,Hadith,,0,0,0,,"… اللهم بارك على محمد وعلى آل محمد، كما باركت على إبراهيم وعلى آل إبراهيم إنك حميدٌ مجيد" [صحيح البخاري (3370)]
Dialogue: 0,0:10:19.64,0:10:25.14,Default,,0,0,0,,أما بعد، أيها المؤمنون، إن نداء الله سبحانه وتعالى
Dialogue: 0,0:10:25.14,0:10:30.25,Default,,0,0,0,,لنا جنس الإنسان مرتين في القرآن بالنداءين
Dialogue: 0,0:10:30.25,0:10:35.83,Default,,0,0,0,,المذكورين، تنبيه لحقيقة ما فيهما من الأمر العظيم،
Dialogue: 0,0:10:35.82,0:10:40.72,Default,,0,0,0,,وأن المرأ صائر إلى الله سبحانه وتعالى، وحينئذ
Dialogue: 0,0:10:40.72,0:10:44.70,Ayah,,0,0,0,,(يتذكر الإنسان ما يتذكر من سعيه) [النازعات: 35]
Dialogue: 0,0:10:44.70,0:10:49.87,Default,,0,0,0,,الذي سعاه، فمن أفلح وأنجح سعد، ومن أساء خاب
Dialogue: 0,0:10:49.87,0:10:53.63,Default,,0,0,0,,وخسر، كما قال الله سبحانه وتعالى
Dialogue: 0,0:10:53.72,0:10:57.72,Ayah,,0,0,0,,(كلا إذا دُكَّت الأرض دكًا دكًا،) [الفجر: 21]
Dialogue: 0,0:10:57.72,0:11:02.32,Ayah,,0,0,0,,(وجاء ربك والملك صفًا صفًا،) [الفجر: 22]
Dialogue: 0,0:11:02.32,0:11:10.75,Ayah,,0,0,0,,(وجيء يومئذٍ بجهنم، يومئذ يتذكر الإنسان وأنا له الذكرى،) [الفجر: 23]
Dialogue: 0,0:11:10.75,0:11:14.87,Ayah,,0,0,0,,(يقول يا ليتني قدَّمت لحياتي،) [الفجر: 24]
Dialogue: 0,0:11:14.87,0:11:18.15,Ayah,,0,0,0,,(فيومئذ لا يعذِّب عذابه أحد،) [الفجر: 25]
Dialogue: 0,0:11:18.15,0:11:21.13,Ayah,,0,0,0,,(ولا يُوثِق وتاقه أحد،) [الفجر: 26]
Dialogue: 0,0:11:21.13,0:11:26.17,Default,,0,0,0,,ألا أيها المؤمنون، فأعملوا لذلك اليوم، فإن الله
Dialogue: 0,0:11:26.17,0:11:31.27,Default,,0,0,0,,سبحانه وتعالى قد أبان لكم المحجة، وأقام
Dialogue: 0,0:11:31.27,0:11:36.60,Default,,0,0,0,,عليكم الحجة، فاستجيبوا لنداء ربكم، وتمسكوا
Dialogue: 0,0:11:36.60,0:11:41.84,Default,,0,0,0,,دينكم، وابتغوا مرضاته سبحانه، واسعوا في دنياكم
Dialogue: 0,0:11:41.84,0:11:47.00,Default,,0,0,0,,بما يحبه ويرضاه، واعلموا أنكم إليهم انقلبون،
Dialogue: 0,0:11:47.00,0:11:52.20,Default,,0,0,0,,وإلى الآخرة صائرون، وأن أمامكم حساب وجزاء،
Dialogue: 0,0:11:52.32,0:11:57.62,Default,,0,0,0,,وأن الحساب والجزاء من ملككم الذي ناداكم، فقال
Dialogue: 0,0:11:57.62,0:12:03.10,Default,,0,0,0,,لكم في تلك الآيتين يا أيها الإنسان، ألا فيا
Dialogue: 0,0:12:03.10,0:12:08.53,Default,,0,0,0,,أيها الإنسان، كرِّر النظر في ذلك النداء، وانظر ما فيه
Dialogue: 0,0:12:08.53,0:12:12.77,Default,,0,0,0,,من المعاني العظام الجليلة، واعتبر، وادكر،
Dialogue: 0,0:12:12.77,0:12:16.13,Ayah,,0,0,0,,(قبل أن يأتي يوم لا يمكن فيه) [البقرة: 254]
Dialogue: 0,0:12:16.13,0:12:17.96,Default,,0,0,0,,الاعتبار ولا الاتعاض،
Dialogue: 0,0:12:18.36,0:12:26.36,Hadith,,0,0,0,,"اللهم أتِ نفوسنا تقواها، وزكِّها أنت خير من زكاها، أنت وليها ومولاها، اللهم إنا" [صحيح مسلم (6906)]
Dialogue: 0,0:12:26.36,0:12:30.15,Default,,0,0,0,,نسألك الهدى والتقى والعفاف والغنى،
Dialogue: 0,0:12:30.15,0:12:38.27,Ayah,,0,0,0,,(اللهم حبِّب إلينا الإيمان، وزيِّنه في قلوبنا، وكرِّ إلينا الكفر والحسوق والعصيان،) [الحجرات: 7]
Dialogue: 0,0:12:38.27,0:12:43.98,Default,,0,0,0,,واجعلنا من عبادك الصالحين، اللهم بارِك لنا في فعل الخيرات،
Dialogue: 0,0:12:43.98,0:12:50.44,Default,,0,0,0,,وهيِّئ لنا إتيان الطاعات، وباعد بيننا وباعدنا، اللهم
Dialogue: 0,0:12:50.44,0:12:56.22,Default,,0,0,0,,أحينا على خير حال، وأمِتنا على خير حال، أقلبنا جميعاً
Dialogue: 0,0:12:56.22,0:13:01.29,Default,,0,0,0,,إلى خير المآل، اللهم أحينا على الإسلام والسنة، وتوفنا
Dialogue: 0,0:13:01.29,0:13:06.37,Default,,0,0,0,,على الإسلام والسنة، اللهم فرِّج قُربَ المكروبين، ونفِّس هموم
Dialogue: 0,0:13:06.37,0:13:12.00,Default,,0,0,0,,المهمومين، واقضِ الدَّين عن المدينين، واشفِ مرضَنا ومرضَانا
Dialogue: 0,0:13:12.00,0:13:17.70,Default,,0,0,0,,ومرضَ المسلمين، اللهم وفِّق وليَّ أمرنا بتوفيقِك، وأيِّده بتأييدِك،
Dialogue: 0,0:13:17.96,0:13:23.22,Default,,0,0,0,,وازقه البطانة الناصحة الصالحة، وجنبه بطانة السوء
Dialogue: 0,0:13:23.48,0:13:29.00,Hadith,,0,0,0,,"اللهم أغثنا، اللهم أغثنا، اللهم أغثنا،" [صحيح البخاري (1014)]
Dialogue: 0,0:13:29.00,0:13:32.82,Default,,0,0,0,,اللهم اسقنا الغيت ولا تجعلنا من القانطين
Dialogue: 0,0:13:41.72,0:13:49.87,Default,,0,0,0,,اللهم اسق البلاد والعباد، اللهم
Dialogue: 0,0:13:49.87,0:13:56.00,Default,,0,0,0,,انشر رحمتك، اللهم
Dialogue: 0,0:13:56.00,0:14:01.15,Default,,0,0,0,,لا تعاملنا بما نحن أهله، وعاملنا بما أنت
Dialogue: 0,0:14:01.15,0:14:04.51,Default,,0,0,0,,أهله، إنك أنت أهل التقوى والمغفرة
