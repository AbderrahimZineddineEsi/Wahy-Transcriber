[
 {
  "id": "Adhkar:tahlil",
  "category": "التهليل",
  "ref": "التهليل",
  "t": "لَا إِلَٰهَ إِلَّا اللَّهُ"
 },
 {
  "id": "Adhkar:tahlil_full",
  "category": "التهليل",
  "ref": "التهليل الجامع",
  "t": "لَا إِلَٰهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ"
 },
 {
  "id": "Adhkar:tasbih",
  "category": "التسبيح",
  "ref": "التسبيح",
  "t": "سُبْحَانَ اللَّهِ"
 },
 {
  "id": "Adhkar:tasbih_hamd",
  "category": "التسبيح",
  "ref": "التسبيح والتحميد",
  "t": "سُبْحَانَ اللَّهِ وَبِحَمْدِهِ"
 },
 {
  "id": "Adhkar:tasbih_azim",
  "category": "التسبيح",
  "ref": "التسبيح",
  "t": "سُبْحَانَ اللَّهِ الْعَظِيمِ"
 },
 {
  "id": "Adhkar:kalimatan",
  "category": "التسبيح",
  "ref": "كلمتان حبيبتان إلى الرحمن",
  "t": "سُبْحَانَ اللَّهِ وَبِحَمْدِهِ سُبْحَانَ اللَّهِ الْعَظِيمِ"
 },
 {
  "id": "Adhkar:tahmid",
  "category": "التحميد",
  "ref": "التحميد",
  "t": "الْحَمْدُ لِلَّهِ"
 },
 {
  "id": "Adhkar:takbir",
  "category": "التكبير",
  "ref": "التكبير",
  "t": "اللَّهُ أَكْبَرُ"
 },
 {
  "id": "Adhkar:baqiyat",
  "category": "الباقيات الصالحات",
  "ref": "الباقيات الصالحات",
  "t": "سُبْحَانَ اللَّهِ وَالْحَمْدُ لِلَّهِ وَلَا إِلَٰهَ إِلَّا اللَّهُ وَاللَّهُ أَكْبَرُ"
 },
 {
  "id": "Adhkar:hawqala",
  "category": "الحوقلة",
  "ref": "الحوقلة",
  "t": "لَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ"
 },
 {
  "id": "Adhkar:istighfar",
  "category": "الاستغفار",
  "ref": "الاستغفار",
  "t": "أَسْتَغْفِرُ اللَّهَ"
 },
 {
  "id": "Adhkar:istighfar_tawba",
  "category": "الاستغفار",
  "ref": "الاستغفار والتوبة",
  "t": "أَسْتَغْفِرُ اللَّهَ وَأَتُوبُ إِلَيْهِ"
 },
 {
  "id": "Adhkar:basmala",
  "category": "البسملة",
  "ref": "البسملة",
  "t": "بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ"
 },
 {
  "id": "Adhkar:istiadha",
  "category": "الاستعاذة",
  "ref": "الاستعاذة",
  "t": "أَعُوذُ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ"
 },
 {
  "id": "Adhkar:hasbala",
  "category": "الحسبلة",
  "ref": "الحسبلة",
  "t": "حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ"
 },
 {
  "id": "Adhkar:istirja",
  "category": "الاسترجاع",
  "ref": "الاسترجاع",
  "t": "إِنَّا لِلَّهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ"
 },
 {
  "id": "Adhkar:salat_nabi",
  "category": "الصلاة على النبي",
  "ref": "الصلاة على النبي ﷺ",
  "t": "اللَّهُمَّ صَلِّ وَسَلِّمْ عَلَىٰ نَبِيِّنَا مُحَمَّدٍ"
 },
 {
  "id": "Adhkar:mashallah",
  "category": "أذكار متفرقة",
  "ref": "ما شاء الله",
  "t": "مَا شَاءَ اللَّهُ لَا قُوَّةَ إِلَّا بِاللَّهِ"
 }
]
