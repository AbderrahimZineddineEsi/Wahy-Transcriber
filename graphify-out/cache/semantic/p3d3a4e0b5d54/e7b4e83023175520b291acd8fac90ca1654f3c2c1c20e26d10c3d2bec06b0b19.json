{"nodes": [{"id": "notebooks_md_kaggle__finished__wahy_finetuning_laya_v2_run3", "label": "Notebook: Run 3 - envelope v2 ablation on laya_v2 (5 models, 2 epochs)", "file_type": "document", "source_file": "notebooks/md/kaggle__finished__wahy-finetuning-laya-v2-run3.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Third run on the new laya_v2 dataset, same labels/lectures/split as runs 1-2. Changes what Laya reads (envelope v2): lecture fields before corpus text, duplicate verse text removed, max length 2048, boundary as two yes/no questions (start cut off, end cut off) with word-overlap evidence. Micro-batch 4 x accum 8 (same effective batch 64) because of long inputs. Expect ~3-3.5 h. Hub repos ZenoAbderrahim/laya-wahy-v2-<run>. Results (from run 4 notebook): short-verse fix works (real rejected 3/64 -> 0/64) but verdict AUC fell 0.945 -> 0.857-0.890 and the yes/no boundary collapsed to never-cut-off (balanced 0.5)."}, {"id": "notebooks_md_kaggle__finished__wahy_finetuning_laya_v2_run3_base", "label": "Run 3 run base (v2 envelope, no passages, no neighbours)", "file_type": "concept", "source_file": "notebooks/md/kaggle__finished__wahy-finetuning-laya-v2-run3.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ablation baseline: only the always-on v2 fixes."}, {"id": "notebooks_md_kaggle__finished__wahy_finetuning_laya_v2_run3_passages", "label": "Run 3 run passages (D: consecutive verses as one passage)", "file_type": "concept", "source_file": "notebooks/md/kaggle__finished__wahy-finetuning-laya-v2-run3.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fix D for the Al-Waqia 89 / Abasa 35-36 short-verse failure; each passage answer is scored per verse."}, {"id": "notebooks_md_kaggle__finished__wahy_finetuning_laya_v2_run3_neighbours", "label": "Run 3 run neighbours (A: nearest findings listed)", "file_type": "concept", "source_file": "notebooks/md/kaggle__finished__wahy-finetuning-laya-v2-run3.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fix A, risk is 'has a neighbour -> accept' so not-a-quote recall must not fall."}, {"id": "notebooks_md_kaggle__finished__wahy_finetuning_laya_v2_run3_both", "label": "Run 3 run both (passages + neighbours) - the main answer, run first", "file_type": "concept", "source_file": "notebooks/md/kaggle__finished__wahy-finetuning-laya-v2-run3.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trained first so a session dying late still yields the main answer."}, {"id": "notebooks_md_kaggle__finished__wahy_finetuning_laya_v2_run3_both_synth", "label": "Run 3 run both_synth (both + counterfactual boundary rows in train)", "file_type": "concept", "source_file": "notebooks/md/kaggle__finished__wahy-finetuning-laya-v2-run3.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only model whose boundary left collapse (0.60/0.59 balanced, still under the no-model rule's 0.69/0.75) but also the lowest verdict score."}, {"id": "notebooks_md_kaggle__finished__wahy_finetuning_laya_v2_run3_noul_true_weight", "label": "--noul-true-weight 3.0 (a 'yes, cut off' answer weighs 3x in the loss)", "file_type": "concept", "source_file": "notebooks/md/kaggle__finished__wahy-finetuning-laya-v2-run3.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Yes answers are only ~10 percent of the yes/no boundary answers, so they are up-weighted; yes/no baseline for balanced accuracy is 0.5 (4-class 0.25)."}, {"id": "notebooks_md_kaggle__finished__wahy_finetuning_laya_v2_run3_before_app_model", "label": "'Before' line: app model ZenoAbderrahim/laya-wahy-soft_asis on the v1 test file", "file_type": "concept", "source_file": "notebooks/md/kaggle__finished__wahy-finetuning-laya-v2-run3.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run 3 onwards evaluates the private production model (needs HF_TOKEN) with eval_laya predict on v1_test.jsonl and cached v1_baselines.json, so every new model is compared with what the app runs today. Reused in runs 4, 5 and 6."}], "edges": [{"source": "notebooks_md_kaggle__finished__wahy_finetuning_laya_v2_run3", "target": "notebooks_md_kaggle__finished__laya_learning_curve_kaggle_finished", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "notebooks/md/kaggle__finished__wahy-finetuning-laya-v2-run3.md", "source_location": null, "weight": 1.0}, {"source": "notebooks_md_kaggle__finished__wahy_finetuning_laya_v2_run3", "target": "notebooks_md_kaggle__finished__wahy_finetuning_laya_v2_run3_base", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "notebooks/md/kaggle__finished__wahy-finetuning-laya-v2-run3.md", "source_location": null, "weight": 1.0}, {"source": "notebooks_md_kaggle__finished__wahy_finetuning_laya_v2_run3", "target": "notebooks_md_kaggle__finished__wahy_finetuning_laya_v2_run3_passages", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "notebooks/md/kaggle__finished__wahy-finetuning-laya-v2-run3.md", "source_location": null, "weight": 1.0}, {"source": "notebooks_md_kaggle__finished__wahy_finetuning_laya_v2_run3", "target": "notebooks_md_kaggle__finished__wahy_finetuning_laya_v2_run3_neighbours", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "notebooks/md/kaggle__finished__wahy-finetuning-laya-v2-run3.md", "source_location": null, "weight": 1.0}, {"source": "notebooks_md_kaggle__finished__wahy_finetuning