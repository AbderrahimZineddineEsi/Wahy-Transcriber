{"nodes": [{"id": "docs_laya_finetune_data", "label": "What data Laya needs, and why (data.md)", "file_type": "document", "source_file": "docs/laya-finetune/data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_laya_finetune_data_two_questions", "label": "Two questions per finding (verdict, boundary_status)", "file_type": "concept", "source_file": "docs/laya-finetune/data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Laya is a typed-decision model that reads the question text and scores each option at its [MASK]; one row yields two training items."}, {"id": "docs_laya_finetune_data_envelope_state", "label": "Envelope state fields (v1)", "file_type": "concept", "source_file": "docs/laya-finetune/data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Train/serve parity: Laya is trained on exactly the input the app sends, built by buildCanonicalDecisionEnvelope."}, {"id": "docs_laya_finetune_data_build_canonical_decision_envelope", "label": "WahyAiVerifier.buildCanonicalDecisionEnvelope", "file_type": "code", "source_file": "docs/laya-finetune/data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_laya_finetune_data_token_truncation", "label": "max_len 1024 truncation (keeps start, drops end)", "file_type": "concept", "source_file": "docs/laya-finetune/data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "15 rows lose the matched span because a long canonical_corpus_text comes earlier in the JSON; reordering fields would change the app input, so deferred (later done in envelope v2)."}, {"id": "docs_laya_finetune_data_soft_labels", "label": "Soft labels / label smoothing per source (EPS_BY_SOURCE)", "file_type": "concept", "source_file": "docs/laya-finetune/data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One-hot targets push confident-and-wrong logits without bound; 1-eps targets bound the cost of wrong labels. Laya has no per-sample weights, so trust is encoded as target sharpness."}, {"id": "docs_laya_finetune_data_label_priority", "label": "Label source priority (user > written text > Sonnet high > Sonnet medium)", "file_type": "concept", "source_file": "docs/laya-finetune/data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JEV, Gemini and base Laya agree with the user only 78/81/52 percent, so they are baselines, never labels."}, {"id": "docs_laya_finetune_data_written_text_test_only", "label": "Bin Baz written text used for testing only", "file_type": "concept", "source_file": "docs/laya-finetune/data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Its boundary labels disagree with the user's (128/152) because it marks the written lesson, not what was said."}, {"id": "docs_laya_finetune_data_lecture_level_split", "label": "Lecture-level train/val/test split", "file_type": "concept", "source_file": "docs/laya-finetune/data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Near-duplicate findings of the same quote and shared speaker/ASR style would leak across a card-level split; test would measure memory."}, {"id": "docs_laya_finetune_data_class_balance_prior", "label": "Class balance and prior correction (48.5 percent vs ~10 percent not-a-quote)", "file_type": "concept", "source_file": "docs/laya-finetune/data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Options: correct afterwards by Bayes, rebalance data (soft_balanced), or reweight loss (unavailable)."}, {"id": "docs_laya_finetune_data_temperature_calibration", "label": "Temperature calibration fitted on val lectures", "file_type": "concept", "source_file": "docs/laya-finetune/data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The original notebook fits T on a random slice of train items which share lectures; whole held-out lectures avoid over-confident T. One shared choice temperature because of the 2000-record bucket minimum."}, {"id": "docs_laya_finetune_data_engine_fields_hidden", "label": "Engine score/band hidden (engine_agnostic profile)", "file_type": "concept", "source_file": "docs/laya-finetune/data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "engine_score alone gets AUC 0.89, so Laya would learn high score implies real, which breaks when the engine changes."}, {"id": "docs_laya_finetune_data_span_length_shortcut", "label": "Span-length shortcut baseline", "file_type": "concept", "source_file": "docs/laya-finetune/data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Span length alone predicts not-a-quote strongly (92 percent at 2 words, 9 percent at 10+) but rejects all 11 of the user's 1-3 word real quotes."}, {"id": "docs_laya_finetune_data_base_laya_baseline", "label": "Base Laya zero-shot baseline (59.1 percent, 42.7 percent real rejected)", "file_type": "concept", "source_file": "docs/laya-finetune/data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_laya_finetune_data_quoted_by_meaning", "label": "Quoted-by-meaning cards excluded from v1 (243 cards)", "file_type": "concept", "source_file": "docs/laya-finetune/data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not an option of Laya's question; app strict-mode prompt calls paraphrases FALSE while the NOT_SURE text mentions them. Needs changing question and exporter together."}, {"id": "docs_laya_finetune_data_laya_v1_dataset", "label": "laya_v1 dataset (soft_asis, soft_balanced, hard_asis, test, baselines, manifest)", "file_type": "concept", "source_file": "docs/laya-finetune/data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_laya_finetune_data_export_py", "label": "export.py to_laya_row", "file_type": "code", "source_file": "docs/laya-finetune/data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_laya_finetune_data_laya_dataset_py", "label": "laya_dataset.py (assign_splits, build, shortcut_baselines)", "file_type": "code", "source_file": "docs/laya-finetune/data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_laya_finetune_data", "target": "docs_laya_finetune_data_two_questions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/laya-finetune/data.md", "source_location": null, "weight": 1.0}, {"source": "docs_laya_finetune_data", "target": "docs_laya_finetune_data_envelope_state", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/laya-finetune/data.md", "source_location": null, "weight": 1.0}, {"source": "docs_laya_finetune_data", "target": "docs_laya_finetune_data_soft_labels", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/laya-finetune/data.md", "source_location": null, "weight": 1.0}, {"source": "docs_laya_finetune_data", "target": "docs_laya_finetune_data_lecture_level_split", "relation": "references", "confidence": "EXTRACTED", "confidence_score