{"nodes": [{"id": "notebooks_md_kaggle__finished__laya_wahy_finetuning_finished", "label": "Notebook: Run 1 - fine-tune laya-multilingual on laya_v1 (3 variants, 4 epochs)", "file_type": "document", "source_file": "notebooks/md/kaggle__finished__laya-wahy-finetuning-finished.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First Kaggle run. Adapted from the Laya repo's typed-decisions 2xT4 notebook but reads Wahy JSONL and trains the multilingual mmBERT-base checkpoint (the English ModernBERT 'laya' cannot read Arabic). Calibration on val lectures, val loss printed per epoch. Hyperparameters: 4 epochs, micro-batch 8 x 2 GPUs x accum 4 = 64, lr-encoder 2.5e-5, lr-head 1e-4, RLCD loss. Pushes private repos ZenoAbderrahim/laya-wahy-<variant>."}, {"id": "notebooks_md_kaggle__finished__laya_wahy_finetuning_finished_soft_asis", "label": "Run 1 variant soft_asis (soft labels, data as is) - became the production app model", "file_type": "concept", "source_file": "notebooks/md/kaggle__finished__laya-wahy-finetuning-finished.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Soft labels (epsilon per source and question), ~49 percent 'not a quote' training share. Later quoted as the 'before' line: AUC 0.944, accuracy 91.4 percent, 6.4 percent real quotes wrongly rejected on the user's cards. Hub repo ZenoAbderrahim/laya-wahy-soft_asis."}, {"id": "notebooks_md_kaggle__finished__laya_wahy_finetuning_finished_soft_balanced", "label": "Run 1 variant soft_balanced (soft labels, 'not a quote' downsampled to 25 percent)", "file_type": "concept", "source_file": "notebooks/md/kaggle__finished__laya-wahy-finetuning-finished.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tests whether rebalancing classes helps; same recipe as soft_asis."}, {"id": "notebooks_md_kaggle__finished__laya_wahy_finetuning_finished_hard_asis", "label": "Run 1 variant hard_asis (one-hot labels, epsilon 0)", "file_type": "concept", "source_file": "notebooks/md/kaggle__finished__laya-wahy-finetuning-finished.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ablation of label smoothing: same data as soft_asis with hard one-hot labels."}, {"id": "notebooks_md_kaggle__finished__laya_wahy_finetuning_finished_base_laya_zero_shot_eval", "label": "Base Laya zero-shot evaluation (the 'before' line of run 1)", "file_type": "concept", "source_file": "notebooks/md/kaggle__finished__laya-wahy-finetuning-finished.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RUN_BASE_EVAL scores the untouched base checkpoint on the same test set with cached JEV/Gemini baselines so fine-tuning gain is measurable."}, {"id": "notebooks_md_kaggle__finished__laya_wahy_finetuning_finished_dual_t4_torchrun_setup", "label": "Kaggle GPU T4 x2 torchrun DDP + HF Hub push pattern shared by all runs", "file_type": "concept", "source_file": "notebooks/md/kaggle__finished__laya-wahy-finetuning-finished.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every notebook asserts 2 GPUs, pip-pins laya>=0.4.12,<0.5, finds the dataset by manifest.json name, runs torchrun --nproc_per_node=2 train_ddp.py then eval_laya.py predict, logs to /kaggle/working and pushes models to private Hub repos with the HF_TOKEN secret. Save and Run All (commit) runs unattended."}], "edges": [{"source": "notebooks_md_kaggle__finished__laya_wahy_finetuning_finished", "target": "notebooks_md_kaggle__finished__laya_wahy_finetuning_finished_soft_asis", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "notebooks/md/kaggle__finished__laya-wahy-finetuning-finished.md", "source_loca