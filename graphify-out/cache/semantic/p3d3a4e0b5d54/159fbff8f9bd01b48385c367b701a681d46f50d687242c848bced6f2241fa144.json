{"nodes": [{"id": "docs_laya_finetune_envelope_v2", "label": "Laya envelope v2 (run 3)", "file_type": "document", "source_file": "docs/laya-finetune/envelope-v2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_laya_finetune_envelope_v2_short_verse_problem", "label": "Short verses inside a recitation rejected (Al-Waqia 89)", "file_type": "concept", "source_file": "docs/laya-finetune/envelope-v2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "86 percent of Quran findings of 1-3 words are not-a-quote in training, so Laya learned short implies coincidence and ignored the neighbouring verse in context_before."}, {"id": "docs_laya_finetune_envelope_v2_boundary_collapse", "label": "Boundary head collapse (always COMPLETE_SPAN)", "file_type": "concept", "source_file": "docs/laya-finetune/envelope-v2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "81 percent COMPLETE_SPAN and MISSING_BOTH only 20 training examples; balanced accuracy 0.25-0.35 versus no-model rule 0.51."}, {"id": "docs_laya_finetune_envelope_v2_passages", "label": "Passages (consecutive verses merged into one row)", "file_type": "concept", "source_file": "docs/laya-finetune/envelope-v2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chains of consecutive verses are almost always all real (146/149); verses 88-90 as one finding give 0.87 real."}, {"id": "docs_laya_finetune_envelope_v2_neighbor_findings", "label": "neighbor_findings (nearest findings, no verdicts)", "file_type": "concept", "source_file": "docs/laya-finetune/envelope-v2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verdicts omitted because they make results order-dependent and spread mistakes, and add nothing over the bare fact a neighbour was found."}, {"id": "docs_laya_finetune_envelope_v2_yes_no_boundary", "label": "Boundary as two yes/no questions (start_missing, end_missing)", "file_type": "concept", "source_file": "docs/laya-finetune/envelope-v2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auto-heal needs to know which side to extend; MISSING_BOTH becomes yes,yes instead of a 20-example class; yes weighs 3x in loss."}, {"id": "docs_laya_finetune_envelope_v2_boundary_evidence", "label": "prefix_words_heard / suffix_words_heard boundary evidence", "file_type": "concept", "source_file": "docs/laya-finetune/envelope-v2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mirrors eval_laya.rule_boundary (Levenshtein >= 0.75)."}, {"id": "docs_laya_finetune_envelope_v2_build_laya_v2_requests", "label": "buildLayaV2Requests (js/ai-verifier.js)", "file_type": "code", "source_file": "docs/laya-finetune/envelope-v2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single builder for app and datagen so training rows and app requests are byte-identical."}, {"id": "docs_laya_finetune_envelope_v2_variants", "label": "laya_v2 variants (base, passages, neighbours, both, both_synth)", "file_type": "concept", "source_file": "docs/laya-finetune/envelope-v2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_laya_finetune_envelope_v2_counterfactual_rows", "label": "Counterfactual cut-off boundary rows", "file_type": "concept", "source_file": "docs/laya-finetune/envelope-v2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cut-off true by construction, but real misses come from ASR-garbled edges while thes