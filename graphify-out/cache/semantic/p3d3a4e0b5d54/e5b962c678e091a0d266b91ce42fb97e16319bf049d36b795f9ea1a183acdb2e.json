{"nodes": [{"id": "notebooks_md_kaggle__finished__wahy_laya_finetuning_run5", "label": "Notebook: Run 5 - passages on the v1 envelope, verdict only", "file_type": "document", "source_file": "notebooks/md/kaggle__finished__wahy-laya-finetuning-run5.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tests passages (Fix 1) on the canonical v1 envelope. Builds v1_passages in-notebook by converting laya_v2 passages to v1 state (corpus text at top, no neighbours, has_citation_cue) with fixed v1 instructions/criteria. 2 epochs, batch 64, max-len 2048, head-max-len 256, RLCD. ~25-30 min. Hub repos laya-wahy-r5-<run>. Benchmarks to beat: before soft_asis, run 2 curve_100, run 4 v1_verdict. Later result: v1_passages AUC 0.924, accuracy 84.9 percent, real rejected 14.0 percent (cited in run 6)."}, {"id": "notebooks_md_kaggle__finished__wahy_laya_finetuning_run5_v1_passages", "label": "Run 5 v1_passages (merged passages, v1 layout, verdict only) - the candidate", "file_type": "concept", "source_file": "notebooks/md/kaggle__finished__wahy-laya-finetuning-run5.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "cfg_extra wahy_envelope 1, options passages true, questions verdict. Training exclusively on merged passages degraded single-verse sensitivity (false rejections 14.0 percent, short-quote accuracy 58.8 percent) per run 6 notebook. Data later flagged broken in memory notes."}, {"id": "notebooks_md_kaggle__finished__wahy_laya_finetuning_run5_passages_verdict", "label": "Run 5 passages_verdict (merged passages, v2 layout, verdict only) - the control", "file_type": "concept", "source_file": "notebooks/md/kaggle__finished__wahy-laya-finetuning-run5.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same passage data as v1_passages but with corpus text at the bottom (wahy_envelope 2); isolates whether moving corpus text to the top matters."}, {"id": "notebooks_md_kaggle__finished__wahy_laya_finetuning_run5_v2_envelope_culprit", "label": "Finding: v2 envelope layout (corpus text at bottom + neighbour JSON blobs) caused the verdict drop", "file_type": "rationale", "source_file": "notebooks/md/kaggle__finished__wahy-laya-finetuning-run5.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run 4: both_verdict stayed at AUC 0.836 while v1_verdict kept 0.933, so the boundary was not the cause; the culprit was canonical_corpus_text pushed behind hundreds of transcript tokens and noisy skewed neighbor_findings blobs."}], "edges": [{"source": "notebooks_md_kaggle__finished__wahy_laya_finetuning_run5", "target": "notebooks_md_kaggle__finished__wahy_laya_finetuning_run4", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "notebooks/md/kaggle__finished__wahy-laya-finetuning-run5.md", "source_location": null, "weight": 1.0}, {"source": "notebooks_md_kaggle__finished__wahy_laya_finetuning_run5", "target": "notebooks_md_kaggle__finished__wahy_laya_finetuning_run5_v1_passages", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "notebooks/md/kaggle__finished__wahy-laya-finetuning-run5.md", "source_location": null, "weight": 1.0}, {"source": "notebooks_md_kaggle__finished__wahy_laya_finetuning_run5", "target": "notebooks_md_kaggle__finished__wahy_laya_finetuning_run5_passages_verdict", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "notebooks/md/kaggle__finished__wahy-laya-finetuning-run5.md", "source_location": null, "weight": 1.0}, {"source": "notebooks_md_kaggle__finished__wahy_laya_finetuning_run5_v2_envelope_culprit", "target": "notebooks_md_kaggle__finished__wahy_laya_finetuning_run5", "relation": "rationale_for", "confidence": "EXTRA